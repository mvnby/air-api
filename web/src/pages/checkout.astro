---
import Layout from "../layouts/Layout.astro";
import CheckoutFormFn from "../components/checkout/CheckoutForm.vue";

export const prerender = true;
---

<Layout title="Оформление заказа">
    <div class="container checkout-page-wrapper">
        <h1 class="gradient-text">Оформление заказа</h1>
        <CheckoutFormFn client:load />
    </div>
</Layout>

<style is:global>
    .checkout-page-wrapper {
        padding: 3rem 1.5rem;
    }
    .page-title {
        font-family: "Space Grotesk", sans-serif;
        font-size: 2.5rem;
        line-height: 1.1;
        margin-bottom: 2rem;
        background: linear-gradient(90deg, var(--primary), var(--primary-dark));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* FAIL-SAFE TWO-COLUMN GRID (FORCED DESKTOP) */
    @media (min-width: 901px) {
        .checkout-layout-grid-v2 {
            display: grid !important;
            grid-template-columns: 1fr 420px !important;
            gap: clamp(2rem, 4vw, 4rem) !important;
            align-items: start !important;
            max-width: 1200px;
            margin: 0 auto;
        }

        .sticky-sidebar {
            position: sticky !important;
            top: 100px !important;
        }
    }

    @media (max-width: 900px) {
        .checkout-layout-grid-v2 {
            display: flex !important;
            flex-direction: column !important;
            gap: 2rem !important;
        }
        .summary-section {
            order: -1;
        }
    }

    @media (max-width: 640px) {
        .checkout-page-wrapper {
            padding: 1.5rem 1rem;
        }
        .page-title {
            font-size: 2rem;
        }
    }
</style>
