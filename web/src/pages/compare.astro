---
import Layout from "../layouts/Layout.astro";
import ProductCompareView from "../components/product/ProductCompareView.vue";

export const prerender = true;
---

<Layout
    title="Сравнение кондиционеров"
    description="Сравните до трёх кондиционеров по площади, компрессору, Wi-Fi, обогреву, шуму, цене и наличию."
    canonical="/compare/"
    robots="noindex,follow"
>
    <div class="container compare-page">
        <nav class="breadcrumb" aria-label="Хлебные крошки">
            <a href="/">Главная</a><span>/</span><a href="/catalog/">Каталог</a><span>/</span><span>Сравнение</span>
        </nav>
        <header>
            <h1>Сравнение кондиционеров</h1>
            <p>Смотрите характеристики рядом, затем откройте карточки моделей или уточните подбор под помещение.</p>
        </header>
        <ProductCompareView client:load />
    </div>
</Layout>

<style>
    .compare-page { padding-top: 2rem; padding-bottom: 5rem; }
    .breadcrumb { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 1.5rem; color: var(--text-muted); font-size: 0.85rem; }
    .breadcrumb a { color: inherit; text-decoration: none; }
    .compare-page header { max-width: 780px; }
    .compare-page h1 { margin: 0; font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1.05; }
    .compare-page header p { margin: 1rem 0 0; color: var(--text-muted); line-height: 1.6; }
    .breadcrumb a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
    @media (max-width: 640px) { .compare-page { padding-top: 1.25rem; } }
</style>
