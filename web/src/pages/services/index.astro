---
import ServiceCard from "../../components/services/ServiceCard.astro";
import ServiceStartAndRequest from "../../components/services/ServiceStartAndRequest.astro";
import { normalizePhoneForTel, SITE_CONFIG } from "../../config";
import { getServicesByIds, serviceGroups } from "../../config/services";
import Layout from "../../layouts/Layout.astro";
import { getGlobalConfig } from "../../utils/api";

export const prerender = true;

const config = await getGlobalConfig();
const phone = config["phone"] || SITE_CONFIG.phone;
const phoneHref = normalizePhoneForTel(phone) || SITE_CONFIG.phoneClean;

const lifecycle = [
    {
        number: "01",
        icon: "architecture",
        title: "Проект",
        description: "Место блоков, трасса, мощность и режим работы",
    },
    {
        number: "02",
        icon: "construction",
        title: "Монтаж",
        description: "Коммуникации, блоки, вакуумирование и запуск",
    },
    {
        number: "03",
        icon: "settings_suggest",
        title: "Сервис",
        description: "Чистка, диагностика, ремонт и контроль системы",
    },
];

---

<Layout
    title="Услуги по кондиционерам в Витебске"
    description="Проектирование, монтаж, обслуживание и ремонт кондиционеров в Витебске. Решения для квартир, офисов, серверных и объектов с несколькими зонами."
>
    <div class="services-page">
        <section class="services-hero">
            <div class="container hero-grid">
                <div class="hero-copy">
                    <nav class="breadcrumbs" aria-label="Хлебные крошки">
                        <a href="/">Главная</a>
                        <span aria-hidden="true">/</span>
                        <span aria-current="page">Услуги</span>
                    </nav>

                    <p class="section-kicker">MVN · полный цикл работ</p>
                    <h1>
                        Услуги по кондиционерам
                        <span class="gradient-text">от проекта до ремонта</span>
                    </h1>
                    <p class="hero-lead">
                        Помогаем выбрать не название услуги, а правильный
                        следующий шаг: заложить трассу, установить систему,
                        почистить, найти неисправность или спроектировать объект.
                    </p>

                    <div class="hero-actions">
                        <a class="btn btn-primary btn-large" href="#service-groups">
                            Выбрать задачу
                            <span class="material-icons-round" aria-hidden="true">
                                arrow_downward
                            </span>
                        </a>
                        <a class="btn btn-outline btn-large" href="#service-request">
                            <span class="material-icons-round" aria-hidden="true">
                                help_outline
                            </span>
                            Не знаю — описать ситуацию
                        </a>
                    </div>

                    <p class="hero-contact">
                        Или позвоните:
                        <a class="js-track-phone" href={`tel:${phoneHref}`}>{phone}</a>
                        <span aria-hidden="true">·</span>
                        стоимость согласуем после уточнения объёма
                    </p>
                </div>

                <div class="lifecycle-card" aria-labelledby="lifecycle-title">
                    <div class="lifecycle-head">
                        <p>Проект · монтаж · сервис</p>
                        <h2 id="lifecycle-title">Работаем на любом этапе</h2>
                    </div>
                    <ul class="lifecycle-list">
                        {
                            lifecycle.map((stage) => (
                                <li>
                                    <div class="stage-marker" aria-hidden="true">
                                        <span class="stage-number">{stage.number}</span>
                                        <span class="material-icons-round">{stage.icon}</span>
                                    </div>
                                    <div>
                                        <h3>{stage.title}</h3>
                                        <p>{stage.description}</p>
                                    </div>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </section>

        <section class="container service-directory" id="service-groups">
            <div class="directory-intro">
                <p class="section-kicker">Навигатор по услугам</p>
                <h2>Выберите ситуацию, которая ближе к вашей</h2>
                <p>
                    Если задача находится на стыке нескольких разделов, начните
                    с любого подходящего: мы уточним детали и определим
                    необходимый состав работ.
                </p>
            </div>

            <nav class="group-navigation" aria-label="Разделы услуг">
                {
                    serviceGroups.map((group) => (
                        <a href={`#${group.id}`}>
                            {group.title}
                            <span class="material-icons-round" aria-hidden="true">
                                south
                            </span>
                        </a>
                    ))
                }
            </nav>

            <div class="service-groups">
                {
                    serviceGroups.map((group, groupIndex) => (
                        <section class="service-group" id={group.id}>
                            <div class="group-heading">
                                <span class="group-number" aria-hidden="true">
                                    {String(groupIndex + 1).padStart(2, "0")}
                                </span>
                                <div>
                                    <p class="group-kicker">{group.kicker}</p>
                                    <h2>{group.title}</h2>
                                    <p class="group-description">{group.description}</p>
                                </div>
                            </div>

                            <div class="service-grid">
                                {getServicesByIds(group.serviceIds).map((service) => (
                                    <ServiceCard service={service} />
                                ))}
                            </div>
                        </section>
                    ))
                }
            </div>
        </section>

        <ServiceStartAndRequest />
    </div>
</Layout>

<style>
    .services-page {
        overflow: hidden;
    }

    .services-hero {
        padding: clamp(2rem, 5vw, 5rem) 0 clamp(4rem, 8vw, 7rem);
        background:
            radial-gradient(circle at 82% 18%, var(--secondary), transparent 32%),
            var(--bg);
    }

    .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
        align-items: center;
        gap: clamp(2rem, 6vw, 5.5rem);
    }

    .breadcrumbs {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 2rem;
        color: var(--text-muted);
        font-size: 0.86rem;
    }

    .breadcrumbs a:hover {
        color: var(--primary);
    }

    .breadcrumbs a:focus-visible,
    .group-navigation a:focus-visible {
        outline: 3px solid var(--primary);
        outline-offset: 4px;
        border-radius: 8px;
    }

    .section-kicker,
    .group-kicker {
        margin: 0 0 0.75rem;
        color: var(--primary);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.11em;
        text-transform: uppercase;
    }

    h1 {
        max-width: 760px;
        margin: 0;
        font-size: clamp(2.45rem, 6vw, 5rem);
        font-weight: 850;
        letter-spacing: -0.045em;
        line-height: 0.98;
        text-wrap: balance;
    }

    h1 span {
        display: block;
        padding-bottom: 0.08em;
    }

    .hero-lead {
        max-width: 690px;
        margin: 1.5rem 0 0;
        color: var(--text-muted);
        font-size: clamp(1.02rem, 2vw, 1.2rem);
        line-height: 1.7;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-top: 2rem;
    }

    .hero-contact {
        margin-top: 1.5rem;
        color: var(--text-muted);
        font-size: 0.84rem;
        line-height: 1.5;
    }

    .hero-contact a {
        color: var(--primary);
        font-weight: 750;
    }

    .lifecycle-card {
        position: relative;
        padding: clamp(1.4rem, 3vw, 2rem);
        border: 1px solid var(--panel-glass-border);
        border-radius: 28px;
        background: var(--panel-glass-bg);
        box-shadow: var(--panel-glass-shadow);
        backdrop-filter: blur(18px);
    }

    .lifecycle-card::before,
    .lifecycle-card::after {
        content: "";
        position: absolute;
        width: 48px;
        height: 48px;
        pointer-events: none;
    }

    .lifecycle-card::before {
        top: -10px;
        left: -10px;
        border-top: 4px solid var(--primary);
        border-left: 4px solid var(--primary);
        border-radius: 12px 0 0;
    }

    .lifecycle-card::after {
        right: -10px;
        bottom: -10px;
        border-right: 4px solid var(--primary);
        border-bottom: 4px solid var(--primary);
        border-radius: 0 0 12px;
    }

    .lifecycle-head {
        padding-bottom: 1.35rem;
        border-bottom: 1px solid var(--panel-chip-border);
    }

    .lifecycle-head p {
        margin: 0 0 0.4rem;
        color: var(--primary);
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .lifecycle-head h2 {
        margin: 0;
        font-size: clamp(1.45rem, 2.4vw, 2rem);
        text-wrap: balance;
    }

    .lifecycle-list {
        display: grid;
        gap: 0;
        margin: 0;
        padding: 0;
    }

    .lifecycle-list li {
        position: relative;
        display: grid;
        grid-template-columns: 58px 1fr;
        gap: 1rem;
        padding: 1.25rem 0;
    }

    .lifecycle-list li:not(:last-child) {
        border-bottom: 1px solid var(--panel-chip-border);
    }

    .stage-marker {
        position: relative;
        width: 54px;
        height: 54px;
        display: grid;
        place-items: center;
        border: 1px solid var(--panel-chip-border);
        border-radius: 16px;
        background: var(--panel-chip-bg);
        color: var(--primary);
    }

    .stage-marker .material-icons-round {
        font-size: 1.45rem;
    }

    .stage-number {
        position: absolute;
        top: -8px;
        right: -8px;
        min-width: 25px;
        padding: 0.2rem 0.3rem;
        border-radius: 999px;
        background: var(--primary);
        color: var(--panel-active-text);
        font-size: 0.63rem;
        font-weight: 800;
        text-align: center;
    }

    .lifecycle-list h3 {
        margin: 0 0 0.35rem;
        font-size: 1.05rem;
    }

    .lifecycle-list p {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .service-directory {
        padding-top: clamp(4.5rem, 8vw, 7rem);
        padding-bottom: clamp(4.5rem, 8vw, 7rem);
        scroll-margin-top: 110px;
    }

    .directory-intro {
        max-width: 760px;
    }

    .directory-intro h2 {
        margin: 0;
        font-size: clamp(2rem, 4.5vw, 3.4rem);
        letter-spacing: -0.035em;
        line-height: 1.06;
        text-wrap: balance;
    }

    .directory-intro > p:last-child {
        max-width: 680px;
        margin: 1rem 0 0;
        color: var(--text-muted);
        font-size: 1.02rem;
        line-height: 1.65;
    }

    .group-navigation {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        margin-top: 2rem;
    }

    .group-navigation a {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.65rem 0.85rem;
        border: 1px solid var(--panel-chip-border);
        border-radius: 999px;
        background: var(--panel-chip-bg);
        color: var(--text);
        font-size: 0.86rem;
        font-weight: 700;
        transition:
            border-color 180ms ease,
            color 180ms ease,
            transform 180ms ease;
    }

    .group-navigation a:hover {
        transform: translateY(-2px);
        border-color: var(--panel-chip-hover-border);
        color: var(--primary);
    }

    .group-navigation .material-icons-round {
        font-size: 1rem;
    }

    .service-groups {
        display: grid;
        gap: clamp(4.5rem, 9vw, 8rem);
        margin-top: clamp(4rem, 8vw, 7rem);
    }

    .service-group {
        scroll-margin-top: 110px;
    }

    .group-heading {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 1.15rem;
        max-width: 820px;
        margin-bottom: 1.75rem;
    }

    .group-number {
        width: 3rem;
        height: 3rem;
        display: grid;
        place-items: center;
        border-radius: 14px;
        background: var(--primary);
        color: var(--panel-active-text);
        font-size: 0.82rem;
        font-weight: 850;
    }

    .group-kicker {
        margin-bottom: 0.4rem;
        color: var(--text-muted);
        letter-spacing: 0.08em;
    }

    .group-heading h2 {
        margin: 0;
        font-size: clamp(1.7rem, 3.2vw, 2.55rem);
        letter-spacing: -0.025em;
    }

    .group-description {
        max-width: 690px;
        margin: 0.65rem 0 0;
        color: var(--text-muted);
        line-height: 1.6;
    }

    .service-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.2rem;
    }

    .service-group:nth-child(n + 2) .service-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (max-width: 960px) {
        .hero-grid {
            grid-template-columns: 1fr;
        }

        .lifecycle-card {
            max-width: 720px;
        }

        .service-grid,
        .service-group:nth-child(n + 2) .service-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

    }

    @media (max-width: 680px) {
        .services-hero {
            padding-top: 1.4rem;
        }

        .breadcrumbs {
            margin-bottom: 1.35rem;
        }

        h1 {
            font-size: clamp(2.35rem, 12vw, 3.6rem);
        }

        .hero-actions {
            flex-direction: column;
        }

        .hero-actions .btn {
            width: 100%;
        }

        .lifecycle-card {
            border-radius: 22px;
        }

        .service-directory {
            padding-top: 4rem;
            padding-bottom: 4rem;
        }

        .group-navigation {
            flex-direction: column;
            align-items: stretch;
        }

        .group-navigation a {
            justify-content: space-between;
            border-radius: 14px;
        }

        .service-groups {
            gap: 4.5rem;
            margin-top: 4.5rem;
        }

        .group-heading {
            grid-template-columns: 1fr;
        }

        .service-grid,
        .service-group:nth-child(n + 2) .service-grid {
            grid-template-columns: 1fr;
            gap: 0.85rem;
        }

    }

    @media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }

        .group-navigation a {
            transition: none;
        }
    }
</style>
