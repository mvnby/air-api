---
import Layout from "../layouts/Layout.astro";

export const prerender = true;
---

<Layout
    title="Заказ оформлен"
    description="Заявка отправлена в MVN. Эта служебная страница закрыта от индексации."
    robots="noindex,follow"
    canonical="/success/"
>
    <div class="container success-page">
        <div class="success-card">
            <div class="icon-circle">
                <span class="material-icons-round">check_circle</span>
            </div>
            <h1 class="gradient-text">Спасибо за заказ!</h1>
            <p>
                Мы уже получили вашу заявку. Менеджер свяжется с вами в
                ближайшее время для подтверждения деталей.
            </p>
            <div class="actions">
                <a href="/" class="btn btn-primary">На главную</a>
            </div>
        </div>
    </div>
</Layout>

<style>
    .success-page {
        min-height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .success-card {
        background: var(--panel-glass-bg);
        border: 1px solid var(--panel-glass-border);
        padding: 3rem;
        border-radius: 8px;
        text-align: center;
        max-width: 500px;
        box-shadow: var(--panel-glass-shadow);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
    }

    .icon-circle {
        width: 80px;
        height: 80px;
        background: var(--success-bg);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--success-text);
    }
    .material-icons-round {
        font-size: 3rem;
    }

    h1 {
        font-family: "Space Grotesk", sans-serif;
        font-size: 2rem;
        color: var(--text);
        margin: 0;
    }

    p {
        color: var(--text-muted);
        line-height: 1.6;
    }

    .btn-primary {
        background: var(--primary);
        color: var(--panel-active-text);
        padding: 0.8rem 2rem;
        border-radius: 1rem;
        text-decoration: none;
        font-weight: 600;
        transition: background 0.2s;
        display: inline-block;
        margin-top: 1rem;
    }
    .btn-primary:hover {
        background: var(--primary-dark);
    }
</style>
