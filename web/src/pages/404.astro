---
import Layout from "../layouts/Layout.astro";

Astro.response.status = 404;
---

<Layout
    title="404: Страница не найдена"
    description="Запрошенная страница не найдена. Перейдите в каталог кондиционеров или на главную страницу."
    robots="noindex,follow"
    canonical="/404"
>
    <section class="not-found">
        <div class="blob blob-left"></div>
        <div class="blob blob-right"></div>

        <div class="container not-found-content">
            <span class="error-code">404</span>
            <h1 class="gradient-text">Страница не найдена</h1>
            <p>
                Похоже, ссылка устарела или адрес был введен с ошибкой.
                Продолжите с одного из популярных разделов.
            </p>

            <div class="actions">
                <a href="/catalog" class="btn btn-primary btn-large">
                    В каталог
                    <span class="material-icons-round">arrow_forward</span>
                </a>
                <a href="/" class="btn btn-outline btn-large">На главную</a>
            </div>

            <div class="popular card">
                <h2>Популярные разделы</h2>
                <div class="popular-grid">
                    <a href="/services" class="popular-link">
                        <span class="material-icons-round">build</span>
                        Услуги
                    </a>
                    <a href="/blog" class="popular-link">
                        <span class="material-icons-round">article</span>
                        Статьи
                    </a>
                    <a href="/contacts" class="popular-link">
                        <span class="material-icons-round">call</span>
                        Контакты
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    .not-found {
        position: relative;
        overflow: hidden;
        padding: 5rem 0 6rem;
    }

    .not-found-content {
        position: relative;
        z-index: 1;
        max-width: 760px;
        text-align: center;
    }

    .error-code {
        display: inline-block;
        font-size: clamp(4rem, 14vw, 8rem);
        line-height: 1;
        font-weight: 800;
        letter-spacing: 0.04em;
        color: var(--primary);
        opacity: 0.18;
        margin-bottom: 0.5rem;
    }

    h1 {
        font-size: clamp(2rem, 4vw, 3rem);
        margin-bottom: 1rem;
    }

    p {
        color: var(--text-muted);
        font-size: 1.05rem;
        max-width: 640px;
        margin: 0 auto 2rem;
    }

    .actions {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }

    .popular {
        text-align: left;
        max-width: 680px;
        margin: 0 auto;
    }

    .popular h2 {
        font-size: 1.3rem;
        margin-bottom: 1rem;
    }

    .popular-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.8rem;
    }

    .popular-link {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.8rem 1rem;
        border: 1px solid var(--border);
        border-radius: 0.9rem;
        color: var(--text);
        font-weight: 600;
        background: var(--surface);
    }

    .popular-link:hover {
        border-color: var(--primary);
        transform: translateY(-2px);
    }

    .blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(60px);
        z-index: 0;
        pointer-events: none;
    }

    .blob-left {
        width: 300px;
        height: 300px;
        background: rgba(45, 212, 191, 0.25);
        left: -80px;
        top: 30px;
    }

    .blob-right {
        width: 320px;
        height: 320px;
        background: rgba(14, 165, 233, 0.2);
        right: -100px;
        bottom: 40px;
    }

    @media (max-width: 720px) {
        .not-found {
            padding: 3.5rem 0 4.5rem;
        }

        .popular-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
