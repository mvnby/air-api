---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { getProductBySlug } from "../../utils/api";

const { slug } = Astro.params;
const product = await getProductBySlug(slug);

if (!product) {
    return Astro.redirect("/404");
}

// Convert specs if it's not a proper object (fallback)
const specs = product.specs || {};
const images = product.images || [];
---

<Layout title={product.title}>
    <div class="container product-page">
        <nav class="breadcrumb">
            <a href="/">Главная</a> / <a href="/catalog">Каталог</a> / <span
                >{product.title}</span
            >
        </nav>

        <div class="product-layout">
            <div class="product-visuals">
                <div class="main-image">
                    <img
                        src={product.main_image || "/placeholder.jpg"}
                        alt={product.title}
                        id="mainImg"
                    />
                </div>
                {
                    images.length > 0 && (
                        <div class="image-gallery">
                            <img
                                src={product.main_image}
                                class="thumb active"
                                onclick="document.getElementById('mainImg').src=this.src"
                            />
                            {images.map((img) => (
                                <img
                                    src={img}
                                    class="thumb"
                                    onclick="document.getElementById('mainImg').src=this.src"
                                />
                            ))}
                        </div>
                    )
                }
            </div>

            <div class="product-info">
                <div class="info-header">
                    {
                        product.is_inverter && (
                            <span class="badge">Inverter Technology</span>
                        )
                    }
                    <h1>{product.title}</h1>
                    <p class="sku">Slug: {product.slug}</p>
                </div>

                <div class="price-section">
                    <span class="price"
                        >{product.price.toLocaleString()} Br</span
                    >
                    {
                        product.old_price && (
                            <span class="old-price">
                                {product.old_price.toLocaleString()} Br
                            </span>
                        )
                    }
                </div>

                <div class="quick-specs">
                    <div class="spec-item">
                        <span class="label">Площадь</span>
                        <span class="value">{product.area} м²</span>
                    </div>
                    <div class="spec-item">
                        <span class="label">Мощность</span>
                        <span class="value">{product.power_cooling} кВт</span>
                    </div>
                </div>

                <div class="actions">
                    <button class="btn btn-primary btn-large"
                        >Добавить в корзину</button
                    >
                    <button class="btn btn-outline">Заказать монтаж</button>
                </div>

                <div class="tabs">
                    <div class="tab-header">
                        <span class="active">Характеристики</span>
                    </div>
                    <div class="tab-content">
                        <table class="specs-table">
                            {
                                Object.entries(specs).map(([key, value]) => (
                                    <tr>
                                        <td class="key">{key}</td>
                                        <td class="val">{value}</td>
                                    </tr>
                                ))
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .product-page {
        padding: 2rem 0;
    }
    .breadcrumb {
        margin-bottom: 2rem;
        color: var(--text-muted);
        font-size: 0.9rem;
    }
    .breadcrumb a:hover {
        color: var(--primary);
    }

    .product-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: start;
    }

    .main-image {
        background: white;
        border-radius: 1.5rem;
        padding: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 500px;
        box-shadow: var(--card-shadow);
        margin-bottom: 1.5rem;
    }
    .main-image img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    .image-gallery {
        display: flex;
        gap: 1rem;
        overflow-x: auto;
        padding-bottom: 0.5rem;
    }
    .thumb {
        width: 80px;
        height: 80px;
        border-radius: 0.5rem;
        border: 1px solid #e5e7eb;
        cursor: pointer;
        padding: 5px;
        background: white;
        object-fit: contain;
    }
    .thumb.active {
        border-color: var(--primary);
        border-width: 2px;
    }

    .info-header h1 {
        font-size: 2.5rem;
        margin: 0.5rem 0;
        line-height: 1.2;
    }
    .sku {
        color: var(--text-muted);
        font-size: 0.85rem;
    }
    .badge {
        background: #eff6ff;
        color: var(--primary);
        padding: 0.25rem 0.75rem;
        border-radius: 1rem;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .price-section {
        margin: 2rem 0;
        display: flex;
        align-items: baseline;
        gap: 1rem;
    }
    .price {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--text);
    }
    .old-price {
        font-size: 1.5rem;
        color: var(--text-muted);
        text-decoration: line-through;
    }

    .quick-specs {
        display: flex;
        gap: 3rem;
        margin-bottom: 2.5rem;
        padding: 1.5rem;
        background: #f8fafc;
        border-radius: 1rem;
    }
    .spec-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    .spec-item .label {
        font-size: 0.8rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .spec-item .value {
        font-size: 1.25rem;
        font-weight: 600;
    }

    .actions {
        display: flex;
        gap: 1rem;
        margin-bottom: 3rem;
    }
    .btn-large {
        flex: 1;
        padding: 1.25rem;
        font-size: 1.1rem;
    }

    .tab-header {
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 2rem;
        display: flex;
        gap: 2rem;
    }
    .tab-header span {
        padding: 1rem 0;
        border-bottom: 2px solid transparent;
        cursor: pointer;
        color: var(--text-muted);
        font-weight: 600;
    }
    .tab-header .active {
        border-color: var(--primary);
        color: var(--primary);
    }

    .specs-table {
        width: 100%;
        border-collapse: collapse;
    }
    .specs-table tr {
        border-bottom: 1px solid #f1f5f9;
    }
    .specs-table td {
        padding: 1rem 0;
        vertical-align: top;
    }
    .specs-table .key {
        width: 40%;
        color: var(--text-muted);
    }
    .specs-table .val {
        font-weight: 500;
    }

    @media (max-width: 968px) {
        .product-layout {
            grid-template-columns: 1fr;
        }
        .main-image {
            height: 350px;
        }
    }
</style>
