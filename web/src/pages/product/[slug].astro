                                                                </span>
                                                                <strong>{row.indoor}</strong>
                                                                <span class="pair-note">
                                                                    (внутр.)
                                                                </span>
                                                            </span>
                                                            <span class="pair-point">
                                                                <strong>{row.outdoor}</strong>
                                                                <span class="pair-note">
                                                                    (наруж.)
                                                                </span>
                                                            </span>
                                                            <span class="pair-unit">
                                                                {row.unit}
                                                            </span>
                                                        </span>
                                                    )
                                                }
                                            </li>
                                        ))
                                }
                            </ul>
                        )
                    }
                    {
                        publicSpecsSummary.temperatureNote && (
                            <p class="specs-preview-note">
                                {publicSpecsSummary.temperatureNote}
                            </p>
                        )
