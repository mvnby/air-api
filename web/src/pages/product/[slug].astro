---
import Layout from "../../layouts/Layout.astro";
import { resolveImageUrl, getProducts } from "../../utils/api";
// @ts-expect-error Vue SFC with script setup
import PriceWithToggle from "../../components/PriceWithToggle.vue";
// @ts-expect-error Vue SFC with script setup
import Gallery from "../../components/product/Gallery.vue";
import StickyBuyBar from "../../components/product/StickyBuyBar.vue";
import FeaturesBentoGrid from "../../components/product/FeaturesBentoGrid.vue";
import {
    getDimensions,
    getPerformance,
} from "../../utils/specs";
import { formatPublicSpecsGrouped } from "../../utils/spec-dictionary";
import { generateBentoCards } from "../../utils/bento-cards";

export async function getStaticPaths() {
    const products = await getProducts();
    if (!Array.isArray(products) || products.length === 0) {
        throw new Error("[SSG] Product static paths generation failed: no products returned from API.");
    }

    return products.map((product: any) => ({
        params: { slug: product.slug },
        props: { product },
    }));
}

// Define Props
interface Props {
    product: any;
}

const { product } = Astro.props as Props;

if (!product) {
    return Astro.redirect("/404");
}

const specs = product.specs || {};
const galleryUrls = product.gallery_images?.length
    ? product.gallery_images.map((img: any) => img.url)
    : [];

// 3. Собираем всё вместе: Главное фото + Галерея
// Исключаем legacy product.images так как они низкого качества
const images = [product.main_image, ...galleryUrls]
    .filter(Boolean) // Убираем null/undefined
    .map(resolveImageUrl); // Превращаем в полные ссылки

// Дедупликация (на случай если main_image также есть в gallery_images)
const uniqueImages = [...new Set(images)];

const mainImage = uniqueImages[0];

// Grouped Specs
const dimensions = getDimensions(specs);
const performance = getPerformance(specs);
const publicSpecGroups = formatPublicSpecsGrouped(specs);

// Generate Bento Cards
const bentoCards = generateBentoCards(product);

const publicTags = (product.tags || []).filter((t: any) => t.is_public);
---

<Layout
    title={product.title}
    description={product.description
        ? product.description.slice(0, 160)
        : undefined}
    image={mainImage}
    price={product.price}
    currency="BYN"
    type="product"
>
    <StickyBuyBar
        client:visible
        price={product.price}
        currency="Br"
        vitebskQty={product.vitebsk_qty}
        minskQty={product.minsk_qty}
    />

    <div class="container product-page">
        <nav class="breadcrumb">
            <a href="/">Главная</a>
            <span class="sep">/</span>
            <a href="/catalog">Каталог</a>
            <span class="sep">/</span>
            <span class="active">{product.title}</span>
        </nav>

        <div class="product-grid">
            <!-- Left: Visuals -->
            <div class="visuals-col">
                <Gallery
                    client:visible
                    images={uniqueImages}
                    initialImage={mainImage}
                />
                {
                    product.description && (
                        <div class="gallery-desc">
                            <h3>Описание</h3>
                            <p>{product.description}</p>
                        </div>
                    )
                }
            </div>

            <!-- Right: Info -->
            <div class="info-col">
                <div class="header-section">
                    <div class="badges">
                        {
                            publicTags.map((tag: any) => {
                                const label =
                                    tag.title || tag.name || tag.slug || "";
                                if (!label) return null;

                                // Map tag slugs to icons and types
                                let icon = "label";
                                let type = "default";

                                const slug = tag.slug.toLowerCase();
                                if (slug.includes("inverter")) {
                                    icon = "equalizer";
                                    type = "primary";
                                } else if (slug.includes("area")) {
                                    icon = "straighten";
                                    type = "info";
                                } else if (slug.includes("winter")) {
                                    icon = "ac_unit";
                                    type = "warning";
                                } else if (slug.includes("wifi")) {
                                    icon = "wifi";
                                    type = "success";
                                } else if (
                                    slug.includes("noise") ||
                                    slug.includes("silent")
                                ) {
                                    icon = "volume_off";
                                    type = "info";
                                } else if (slug.includes("hit")) {
                                    icon = "local_fire_department";
                                    type = "error";
                                }

                                return (
                                    <span class={`badge ${type}`}>
                                        <span class="material-icons-round badge-icon">
                                            {icon}
                                        </span>
                                        {label}
                                    </span>
                                );
                            })
                        }
                    </div>
                    <h1 class="gradient-text">{product.title}</h1>
                    <div class="sku-row">
                        <span class="sku"
                            >Артикул: {
                                product.slug.split("-").pop()?.toUpperCase()
                            }</span
                        >
                        {
                            performance.year && (
                                <span class="year-label">
                                    {performance.year}
                                </span>
                            )
                        }
                    </div>
                </div>

                <div class="price-section card">
                    <PriceWithToggle
                        client:visible
                        basePrice={product.price}
                        oldPrice={product.old_price}
                        tags={product.tags}
                        area={product.area}
                        large={true}
                        id={product.slug}
                        productId={product.id}
                        title={product.title}
                        image={mainImage}
                        vitebskQty={product.vitebsk_qty}
                        minskQty={product.minsk_qty}
