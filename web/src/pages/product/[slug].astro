</Layout>

<style>
    /* Глобальные стили или <style> в компоненте */

    /* ☀️ СВЕТЛАЯ ТЕМА (Light Mode) */
    :root {
        --dim-stroke: #1e293b; /* Темно-серые линии для размеров */
        --dim-stroke-light: #94a3b8; /* Светлые вспомогательные линии */
        --dim-fill-body: #e2e8f0; /* Цвет корпуса кондея (светлый серый) */
        --dim-fill-accent: #cbd5e1; /* Цвет решеток/панелей */
        --dim-text: #0f172a; /* Цвет цифр */
    }

    /* 🌙 ТЕМНАЯ ТЕМА (Dark Mode) - если используешь класс .dark на <html> или <body> */
    .dark {
        --dim-stroke: rgba(255, 255, 255, 0.65);
        --dim-stroke-light: rgba(255, 255, 255, 0.35);
        --dim-fill-body: rgba(255, 255, 255, 0.08);
        --dim-fill-accent: rgba(255, 255, 255, 0.12);
        --dim-text: rgba(255, 255, 255, 0.92);
    }

    /* ✨ Добавим плавность при переключении темы */
    .dims-svg path,
    .dims-svg rect,
    .dims-svg line,
    .dims-svg text {
        transition: all 0.3s ease;
    }
    .product-page {
        padding: 3rem 1.5rem;
    }

    .breadcrumb {
        margin-bottom: 2rem;
        color: var(--text-muted, #94a3b8);
        font-size: 0.9rem;
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }
    .breadcrumb a:hover {
        color: var(--primary, #007f80);
    }
    .sep {
        opacity: 0.5;
    }
    .active {
        color: var(--text, #0f172a);
        font-weight: 500;
    }

    /* Layout */
    .product-grid {
        display: grid;
        grid-template-columns: 42% 1fr; /* User requested ~40% for gallery */
        gap: 4rem;
        align-items: start;
    }

    .visuals-col {
        position: sticky;
        top: 2rem;
    }

    /* Info Column */
    .header-section {
        margin-bottom: 2rem;
    }

    h1 {
        font-family: "Space Grotesk", sans-serif;
        font-size: 2.5rem;
        line-height: 1.1;
        margin: 0.5rem 0;
        color: var(--text);
    }

    .badges {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .badge {
        background: var(--secondary);
        color: var(--text-muted);
        padding: 4px 10px;
        border-radius: 10px;
        font-size: 0.75rem;
        line-height: 1;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        min-height: 28px;
        border: 1px solid var(--border);
        transition: all 0.2s;
    }
    .badge-icon {
        font-size: 0.95rem;
        opacity: 0.7;
    }
    .badge.primary {
        background: rgba(0, 127, 128, 0.08);
        color: var(--primary);
        border-color: rgba(0, 127, 128, 0.2);
    }
    .badge.info {
        background: var(--info-bg);
        color: var(--info-text);
        border-color: rgba(14, 165, 233, 0.2);
    }
    .badge.warning {
        background: var(--warning-bg);
        color: var(--warning-text);
        border-color: rgba(245, 158, 11, 0.2);
    }
    .badge.success {
        background: var(--success-bg);
        color: var(--success-text);
        border-color: rgba(16, 185, 129, 0.2);
    }
    .badge.error {
