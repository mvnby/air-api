                                    <span class="label">Охлаждение</span>
                                    <span class="value"
                                        >{performance.powerCooling || "-"}</span
                                    >
                                </div>
                            </div>
                            <div class="spec-card">
                                <span class="material-icons-round icon heat"
                                    >wb_sunny</span
