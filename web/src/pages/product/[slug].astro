                                                    >
                                                        <tspan opacity=".8">
                                                            {dimensions.outer.d}
                                                        </tspan>
                                                    </text>
                                                </g>
                                            </svg>
                                            <div class="box-info">
                                                {dimensions.weightOuter && (
