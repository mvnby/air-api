                                </div>
                            </div>
                            <div class="spec-card">
                                <span class="material-icons-round icon energy"
                                    >bolt</span
                                >
                                <div class="spec-val">
                                    <span class="label">Класс</span>
                                    <span class="value hl"
                                        >{performance.energyClass || "A"}</span
                                    >
                                </div>
                            </div>
                        </div>
                        <div class="extra-row">
                            {
                                performance.freon && (
                                    <div class="extra-item">
                                        <span class="label">Фреон:</span>{" "}
                                        <strong>{performance.freon}</strong>
                                    </div>
                                )
                            }
                            {
                                performance.wifi && (
                                    <div class="extra-item">
                                        <span class="material-icons-round wifi-icon">
                                            wifi
