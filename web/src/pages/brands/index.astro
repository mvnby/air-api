---
import Layout from "../../layouts/Layout.astro";
import {
    applyRuntimeFreshnessHeaders,
    createRuntimeFreshnessContext,
    getPublicBrands,
    resolveImageUrl,
} from "../../utils/api";
import { formatBrandProductCount, getBrandIntro, getBrandIntroPlainText } from "../../utils/brands";

interface PublicBrand {
    id: number;
    title: string;
    slug: string;
    logo_url?: string | null;
    description?: string | null;
    products_count: number;
    sort_order: number;
}

const runtimeFreshness = await createRuntimeFreshnessContext();
const runtimeFreshnessOption = runtimeFreshness ? { runtimeFreshness } : undefined;
const brands = (await getPublicBrands(runtimeFreshnessOption)) as PublicBrand[];
applyRuntimeFreshnessHeaders(Astro.response, runtimeFreshness);
const brandListSchema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Бренды кондиционеров в Витебске",
    url: new URL("/brands/", Astro.url.origin).toString(),
    mainEntity: {
        "@type": "ItemList",
        itemListElement: brands.map((brand, index) => ({
            "@type": "ListItem",
            position: index + 1,
            url: new URL(`/brands/${brand.slug}/`, Astro.url.origin).toString(),
            name: brand.title,
        })),
    },
};
---

<Layout
    title="Бренды кондиционеров в Витебске"
    description="Каталог брендов кондиционеров: подбор, продажа, монтаж и обслуживание в Витебске."
    canonical="/brands/"
>
    <script type="application/ld+json" set:html={JSON.stringify(brandListSchema)} />
    <div class="container brands-page">
        <header class="brands-header">
            <div class="breadcrumb">
                <a href="/">Главная</a>
                <span class="sep">/</span>
                <span>Бренды</span>
            </div>
            <h1 class="gradient-text">Бренды кондиционеров в Витебске</h1>
            <p>
                Подбираем модели под квартиру, дом или офис: учитываем площадь, солнце, наличие на складе и условия
                монтажа.
            </p>
        </header>

        {
            brands.length > 0 ? (
                <section class="brand-grid" aria-label="Список брендов">
                    {brands.map((brand) => (
                        <a class="brand-card" href={`/brands/${brand.slug}/`}>
                            <div class="brand-card-logo" aria-hidden={!brand.logo_url}>
                                {brand.logo_url ? (
                                    <img src={resolveImageUrl(brand.logo_url)} alt={brand.title} loading="lazy" />
                                ) : (
                                    <span>{brand.title.slice(0, 2).toUpperCase()}</span>
                                )}
                            </div>
                            <div class="brand-card-copy">
                                <h2>{brand.title}</h2>
                                <p>{getBrandIntroPlainText(getBrandIntro(brand.title, brand.description))}</p>
                                <span>{formatBrandProductCount(brand.products_count)} в каталоге</span>
                            </div>
                        </a>
                    ))}
                </section>
            ) : (
                <section class="empty-status">
                    <span class="material-icons-round large">inventory_2</span>
                    <h2>Бренды пока не опубликованы</h2>
                    <p>Каталог обновляется. Актуальные модели можно посмотреть в общем каталоге кондиционеров.</p>
                    <a class="btn btn-primary" href="/catalog">Открыть каталог</a>
                </section>
            )
        }
    </div>
</Layout>

<style>
    .brands-page {
        padding: 2rem 1.5rem 3rem;
        max-width: 1200px;
        margin: 0 auto;
    }
    .brands-header {
        margin-bottom: 2rem;
    }
    .breadcrumb {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 500;
        flex-wrap: wrap;
    }
    .breadcrumb a:hover {
        color: var(--primary);
    }
    .sep {
        opacity: 0.5;
    }
    .brands-header h1 {
        font-size: clamp(2rem, 4vw, 3rem);
        margin-bottom: 0.75rem;
        font-weight: 800;
        line-height: 1.1;
    }
    .brands-header p {
        max-width: 780px;
        color: var(--text-muted);
        margin: 0;
        line-height: 1.7;
    }
    .brand-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1rem;
    }
    .brand-card {
        display: grid;
        grid-template-columns: 72px minmax(0, 1fr);
        gap: 1rem;
        min-height: 172px;
        padding: 1rem;
        background: var(--panel-glass-bg);
        border: 1px solid var(--panel-glass-border);
        border-radius: 8px;
        box-shadow: var(--panel-glass-shadow);
    }
    .brand-card:hover {
        border-color: var(--panel-chip-hover-border);
        transform: translateY(-2px);
    }
    .brand-card-logo {
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--panel-chip-bg);
        border: 1px solid var(--panel-chip-border);
        border-radius: 8px;
        color: var(--primary);
        font-weight: 800;
        font-family: "Space Grotesk", sans-serif;
    }
    .brand-card-logo img {
        max-width: 58px;
        max-height: 42px;
        object-fit: contain;
    }
    .brand-card-copy {
        min-width: 0;
    }
    .brand-card-copy h2 {
        margin: 0 0 0.35rem;
        font-size: 1.18rem;
        color: var(--text);
    }
    .brand-card-copy p {
        margin: 0;
        color: var(--text-muted);
        line-height: 1.55;
        font-size: 0.95rem;
    }
    .brand-card-copy span {
        display: inline-flex;
        margin-top: 0.85rem;
        color: var(--primary);
        font-weight: 700;
        font-size: 0.9rem;
    }
    .empty-status {
        min-height: 320px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.8rem;
        text-align: center;
        padding: 2rem;
        background: var(--panel-glass-bg);
        border: 1px solid var(--panel-glass-border);
        border-radius: 8px;
    }
    .empty-status p {
        color: var(--text-muted);
        max-width: 560px;
    }
    .large {
        font-size: 3rem;
        color: var(--text-muted);
        opacity: 0.65;
    }
    @media (max-width: 640px) {
        .brand-card {
            grid-template-columns: 1fr;
        }
    }
</style>
