---
import Layout from "../layouts/Layout.astro";
import ProductGroup from "../components/ProductGroup.astro";
import FeaturedArticles from "../components/blog/FeaturedArticles.astro";
import { getInstallationPricingInfo } from "../utils/api";

const { minStandardPrice, minBundlePrice, discount } =
	await getInstallationPricingInfo();
const hasBundleDiscount =
	Number.isFinite(discount) && discount > 0 && minBundlePrice < minStandardPrice;

const heroServices = [
	{
		title: "Подбор",
		description: "модель под помещение",
		icon: "tune",
	},
	{
		title: "Продажа",
		description: "кондиционеры в наличии",
		icon: "inventory_2",
	},
	{
		title: "Монтаж",
		description: "установка под ключ",
		icon: "construction",
	},
	{
		title: "Сервис",
		description: "чистка и ремонт",
		icon: "cleaning_services",
	},
];

const bundleBenefits = [
	{
		title: "Бесплатный замер",
		description: "перед установкой",
		icon: "straighten",
	},
	{
		title: "Гарантия",
		description: "на монтаж",
		icon: "verified",
	},
	{
		title: "Смета заранее",
		description: "до начала работ",
		icon: "receipt_long",
	},
];

const serviceCards = [
	{
		title: "Подбор и продажа",
		description:
			"Подберем модель по площади, бюджету и режиму работы, чтобы не переплачивать за лишние функции.",
		href: "/catalog",
		icon: "tune",
	},
	{
		title: "Монтаж кондиционеров",
		description:
			"Устанавливаем по согласованной смете и срокам, с гарантией на выполненные работы.",
		href: "/montaj-konditionerov",
		icon: "construction",
	},
	{
		title: "Обслуживание",
		description:
			"Чистка, дезинфекция и профилактика, чтобы техника сохраняла мощность и не начала шуметь или пахнуть.",
		href: "/obslujivanie-kondicionerov",
		icon: "cleaning_services",
	},
	{
		title: "Ремонт",
		description:
			"Диагностика и восстановление кондиционеров, если система не охлаждает, шумит или работает нестабильно.",
		href: "/services/repair",
		icon: "engineering",
	},
];

const residentialBenefits = [
	"Тихие модели для спальни, детской и гостиной",
	"Подбор по площади и реальным условиям помещения",
	"Модели с обогревом для межсезонья и холодных дней",
	"Аккуратный монтаж без лишней грязи и сюрпризов",
];

const businessBenefits = [
	"Подбор решений для кабинетов, магазинов и небольших офисов",
	"Стабильная работа в ежедневной эксплуатации",
	"Обслуживание и профилактика без долгих простоев",
	"Помощь с выбором нескольких внутренних блоков и схемой монтажа",
];

const installIncluded = [
	"Стандартный выезд и оценка монтажа",
	"Качественные расходники и аккуратная трасса",
	"Пусконаладка и проверка после установки",
];

const workflowSteps = [
	"Обсуждаем помещение, бюджет и ожидания по шуму, обогреву и функциям.",
	"Подбираем подходящие модели и заранее называем стоимость монтажа.",
	"Устанавливаем кондиционер, проверяем работу и остаемся на сервисе.",
];
---

<Layout
	title="Главная"
	description="Кондиционеры в Витебске: подбор, продажа, монтаж, обслуживание и ремонт для дома, офиса и бизнеса."
>
	<section class="hero-section">
		<div class="blob blob-1"></div>
		<div class="blob blob-2"></div>
		<div class="hero-noise"></div>

		<div class="container hero-shell">
			<div class="hero-copy">
				<div class="badge hero-badge">Витебск и Витебская область</div>
				<h1>
					Кондиционеры в Витебске
					<span class="gradient-text">с подбором, монтажом и сервисом</span>
				</h1>
				<p class="hero-lead">
					Подбираем и устанавливаем кондиционеры для квартир, домов и
					офисов в Витебске. Работаем по городу, пригороду и ближайшим
					районам области. После монтажа остаемся на сервисе: чистка,
					профилактика и ремонт.
				</p>

				<div class="hero-actions">
					<a href="/contacts" class="btn btn-primary btn-large">
						Получить консультацию
						<span class="material-icons-round" aria-hidden="true">
							arrow_forward
						</span>
					</a>
					<a href="/catalog" class="btn btn-outline btn-large">
						Перейти в каталог
					</a>
				</div>

				<div class="hero-service-grid" aria-label="Основные направления">
					{
						heroServices.map((item) => (
							<div class="service-pill">
								<span class="service-pill-icon material-icons-round" aria-hidden="true">
									{item.icon}
								</span>
								<span>
									<strong>{item.title}</strong>
									<small>{item.description}</small>
								</span>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<section class="container bundle-section">
		<div class="bundle-card">
			<div class="bundle-stat">
				<span class="bundle-stat-value">500+</span>
				<span class="bundle-stat-label">установленных систем</span>
			</div>

			<div class="bundle-benefits" aria-label="Что входит в подготовку монтажа">
				{
					bundleBenefits.map((item) => (
						<div class="bundle-benefit">
							<span class="bundle-benefit-icon material-icons-round" aria-hidden="true">
								{item.icon}
							</span>
							<span>
								<strong>{item.title}</strong>
								<small>{item.description}</small>
							</span>
						</div>
					))
				}
			</div>

			<ul class="bundle-included">
				{
					installIncluded.map((item) => (
						<li>{item}</li>
					))
				}
			</ul>

			<div class="bundle-price-band">
				<div>
					<span class="bundle-price-kicker">Стандартный монтаж</span>
					<strong>
						от {minBundlePrice}
						<span class="price-byn"></span>
					</strong>
					<span class="bundle-price-label">
						при покупке кондиционера у нас
					</span>
				</div>
				<a href="/contacts" class="btn btn-primary">Заказать расчет</a>
				{
					hasBundleDiscount && (
						<p class="bundle-note">
							Скидка {discount} BYN от базовой цены {minStandardPrice} BYN уже
							учтена.
						</p>
					)
				}
			</div>
		</div>
	</section>

	<section class="container workflow-section">
		<div class="workflow-panel">
			<div class="workflow-copy">
				<p class="section-kicker">Как мы работаем</p>
				<h2>Поможем выбрать, установим и обслужим</h2>
				<p>
					Работаем с квартирами, домами, офисами и небольшими коммерческими
					помещениями в Витебске. Если монтаж за городом, заранее согласуем
					выезд, сроки и стоимость.
				</p>
				<ul class="workflow-steps">
					{
						workflowSteps.map((item) => (
							<li>{item}</li>
						))
					}
				</ul>
			</div>

			<div class="workflow-media">
				<div class="coverage-card">
					<span class="context-kicker">Локально</span>
					<strong>Витебск, пригород и ближайшие районы области</strong>
					<span>
						Подбор, монтаж, обслуживание, чистка и ремонт кондиционеров.
					</span>
				</div>
				<img
					src="/img/services/installation.png"
					alt="Комплект кондиционера для установки"
					class="workflow-image"
					width="960"
					height="960"
					fetchpriority="high"
				/>
			</div>
		</div>
	</section>

	<section class="container services-section">
		<div class="section-heading">
			<p class="section-kicker">Что мы делаем</p>
			<h2>Закрываем весь путь от выбора кондиционера до обслуживания</h2>
			<p class="section-lead">
				Подбираем оборудование, устанавливаем, запускаем и помогаем с
				обслуживанием, когда кондиционер уже работает.
			</p>
		</div>

		<div class="services-grid">
			{
				serviceCards.map((card) => (
					<a href={card.href} class="service-card glass">
						<div class="service-icon" aria-hidden="true">
							<span class="material-icons-round">{card.icon}</span>
						</div>
						<div>
							<h3>{card.title}</h3>
							<p>{card.description}</p>
						</div>
						<span class="service-link">
							Подробнее
							<span class="material-icons-round" aria-hidden="true">
								arrow_forward
							</span>
						</span>
					</a>
				))
			}
		</div>
	</section>

	<section class="container audience-section">
		<div class="section-heading narrow">
			<p class="section-kicker">Под разные сценарии</p>
			<h2>Разные задачи, один аккуратный сервис</h2>
			<p class="section-lead">
				Сначала разбираемся, где будет стоять кондиционер, затем предлагаем
				модель и план монтажа.
			</p>
		</div>

		<div class="audience-grid">
			<article class="audience-card">
				<div class="audience-card-top">
					<p class="audience-label">Для квартиры и дома</p>
					<h3>Тихий климат, обогрев в межсезонье и понятный подбор под площадь</h3>
				</div>
				<ul class="audience-list">
					{
						residentialBenefits.map((item) => (
							<li>{item}</li>
						))
					}
				</ul>
				<a href="/catalog?area_max=35" class="audience-link">
					Подобрать для дома
					<span class="material-icons-round" aria-hidden="true">
						arrow_forward
					</span>
				</a>
			</article>

			<article class="audience-card audience-card-alt">
				<div class="audience-card-top">
					<p class="audience-label">Для офиса и бизнеса</p>
					<h3>Рабочие решения для кабинетов, магазинов и небольших коммерческих объектов</h3>
				</div>
				<ul class="audience-list">
					{
						businessBenefits.map((item) => (
							<li>{item}</li>
						))
					}
				</ul>
				<a href="/contacts" class="audience-link">
					Обсудить задачу
					<span class="material-icons-round" aria-hidden="true">
						arrow_forward
					</span>
				</a>
			</article>
		</div>
	</section>

	<div class="container products-section">
		<ProductGroup
			title="Популярные модели в наличии в Витебске"
			vitebskFeatured={true}
			limit={6}
		/>
	</div>

	<FeaturedArticles />

	<div class="container products-section">
		<ProductGroup
			title="Для квартиры до 25 м² с обогревом"
			filters={{ area_max: 29, heating_min: -20 }}
			limit={4}
		/>
	</div>
</Layout>

<style>
	.hero-section {
		padding: 3rem 0 2.5rem;
		position: relative;
		overflow: hidden;
	}

	.hero-section::before {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				180deg,
				rgba(var(--surface-rgb), 0.9) 0%,
				rgba(var(--surface-rgb), 0.72) 54%,
				rgba(var(--surface-rgb), 0.96) 100%
			),
			url("/img/hero/vitebsk-hero.jpg") center right / cover no-repeat;
		opacity: 0.82;
		pointer-events: none;
	}

	.hero-noise {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at top left, rgba(45, 212, 191, 0.08), transparent 28%),
			radial-gradient(circle at bottom right, rgba(0, 127, 128, 0.08), transparent 24%);
		pointer-events: none;
	}

	.blob {
		position: absolute;
		border-radius: 50%;
		filter: blur(90px);
		z-index: -1;
		opacity: 0.16;
	}

	.blob-1 {
		width: 420px;
		height: 420px;
		background: var(--primary);
		top: -120px;
		right: -80px;
	}

	.blob-2 {
		width: 340px;
		height: 340px;
		background: #2dd4bf;
		bottom: 40px;
		left: -70px;
	}

	.hero-shell {
		position: relative;
		z-index: 1;
		max-width: 58rem;
	}

	.hero-copy {
		position: relative;
		min-width: 0;
	}

	.hero-badge {
		margin-bottom: 1.25rem;
	}

	.hero-copy h1 {
		font-size: 3.45rem;
		line-height: 1;
		font-weight: 800;
		letter-spacing: 0;
		max-width: 18ch;
		text-wrap: balance;
		overflow-wrap: normal;
		hyphens: manual;
		margin-bottom: 1.15rem;
	}

	.hero-copy h1 span {
		display: block;
		margin-top: 0.55rem;
	}

	.hero-lead {
		font-size: 1.1rem;
		line-height: 1.65;
		max-width: 52ch;
		color: var(--text-muted);
		margin-bottom: 1.35rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-bottom: 1.25rem;
	}

	.hero-service-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.75rem;
		max-width: 48rem;
	}

	.service-pill {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: start;
		gap: 0.65rem;
		padding: 0.85rem;
		border-radius: 1rem;
		background: rgba(var(--surface-rgb), 0.78);
		border: 1px solid var(--panel-chip-border);
		font-weight: 700;
		color: var(--text);
		box-shadow: var(--panel-glass-shadow);
		min-width: 0;
		backdrop-filter: blur(12px);
	}

	.service-pill-icon {
		width: 1.35rem;
		height: 1.35rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: rgba(13, 148, 136, 0.14);
		color: var(--success);
		font-size: 0.95rem;
		flex-shrink: 0;
	}

	.service-pill strong,
	.service-pill small {
		display: block;
		min-width: 0;
	}

	.service-pill strong {
		font-size: 0.92rem;
		line-height: 1.2;
	}

	.service-pill small {
		margin-top: 0.18rem;
		color: var(--text-muted);
		font-size: 0.78rem;
		font-weight: 600;
		line-height: 1.25;
	}

	.bundle-section {
		position: relative;
		z-index: 2;
		margin-top: -1rem;
		margin-bottom: 4rem;
	}

	.bundle-card {
		display: grid;
		grid-template-columns: minmax(140px, 0.7fr) minmax(0, 1.35fr) minmax(280px, 1fr);
		grid-template-areas:
			"stat benefits price"
			"included included price";
		gap: 0.85rem;
		align-items: stretch;
		padding: 0.9rem;
		border-radius: 1.5rem;
		background: var(--panel-glass-bg);
		border: 1px solid var(--panel-glass-border);
		box-shadow: var(--panel-glass-shadow);
	}

	.bundle-stat,
	.bundle-benefit,
	.bundle-price-band {
		border-radius: 1.1rem;
		border: 1px solid var(--panel-glass-border);
		box-shadow: var(--panel-glass-shadow);
	}

	.bundle-stat {
		grid-area: stat;
		display: grid;
		align-content: center;
		gap: 0.3rem;
		padding: 1.2rem;
		background: rgba(var(--surface-rgb), 0.8);
	}

	.bundle-stat-value {
		font-family: "Space Grotesk", sans-serif;
		font-size: 2.95rem;
		font-weight: 800;
		line-height: 0.95;
		color: var(--text);
	}

	.bundle-stat-label {
		color: var(--text-muted);
		font-weight: 700;
		line-height: 1.35;
	}

	.bundle-benefits {
		grid-area: benefits;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.7rem;
	}

	.bundle-benefit {
		display: grid;
		gap: 0.55rem;
		padding: 1rem;
		background: rgba(var(--surface-rgb), 0.72);
	}

	.bundle-benefit-icon {
		color: var(--primary);
		font-size: 1.45rem;
	}

	.bundle-benefit strong,
	.bundle-benefit small {
		display: block;
	}

	.bundle-benefit strong {
		font-size: 0.9rem;
		line-height: 1.2;
	}

	.bundle-benefit small {
		color: var(--text-muted);
		font-size: 0.78rem;
		line-height: 1.35;
	}

	.bundle-included {
		grid-area: included;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.65rem 1rem;
		padding: 0.25rem 0.2rem 0.1rem;
	}

	.bundle-included li {
		position: relative;
		padding-left: 1.1rem;
		color: var(--primary);
		font-size: 0.9rem;
		font-weight: 700;
		line-height: 1.35;
	}

	.bundle-included li::before {
		content: "";
		position: absolute;
		top: 0.58rem;
		left: 0;
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 999px;
		background: var(--primary);
	}

	.bundle-price-band {
		grid-area: price;
		display: grid;
		gap: 0.75rem;
		align-content: center;
		padding: 1.1rem;
		background: var(--panel-active-gradient);
		color: var(--panel-active-text);
	}

	.bundle-price-kicker,
	.bundle-price-label,
	.bundle-note {
		display: block;
		line-height: 1.35;
	}

	.bundle-price-kicker {
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		opacity: 0.8;
	}

	.bundle-price-band strong {
		display: block;
		font-family: "Space Grotesk", sans-serif;
		font-size: 2rem;
		line-height: 1;
	}

	.bundle-price-label,
	.bundle-note {
		opacity: 0.86;
	}

	.bundle-note {
		font-size: 0.8rem;
	}

	.bundle-price-band .btn {
		width: fit-content;
		background: rgba(var(--surface-rgb), 0.9);
		color: var(--primary);
	}

	.workflow-section {
		margin-bottom: 4.5rem;
	}

	.workflow-panel {
		position: relative;
		overflow: hidden;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(280px, 0.82fr);
		gap: 1.4rem;
		align-items: stretch;
		padding: 1.5rem;
		border-radius: 2rem;
		background: var(--panel-glass-bg);
		border: 1px solid var(--panel-glass-border);
		box-shadow: var(--panel-glass-shadow);
	}

	.workflow-copy {
		display: grid;
		gap: 0.95rem;
		align-content: start;
	}

	.workflow-copy h2 {
		font-size: 2.45rem;
		line-height: 1.05;
		font-weight: 800;
		text-wrap: balance;
	}

	.workflow-copy p {
		color: var(--text-muted);
		line-height: 1.65;
	}

	.workflow-steps {
		display: grid;
		gap: 0.8rem;
	}

	.workflow-steps li {
		position: relative;
		padding-left: 1.25rem;
		color: var(--text);
	}

	.workflow-steps li::before {
		content: "";
		position: absolute;
		top: 0.65rem;
		left: 0;
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: var(--primary);
	}

	.workflow-media {
		position: relative;
		display: grid;
		align-content: end;
		justify-items: end;
		min-height: 19rem;
		padding: 1rem;
		border-radius: 1.5rem;
		overflow: hidden;
		background:
			linear-gradient(
				180deg,
				rgba(var(--surface-rgb), 0.2),
				rgba(var(--surface-rgb), 0.7)
			),
			url("/img/hero/vitebsk-hero.jpg") center right / cover no-repeat;
		border: 1px solid var(--panel-glass-border);
	}

	.coverage-card {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 0.22rem;
		width: min(100%, 18rem);
		padding: 1rem;
