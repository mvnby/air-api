		align-items: center;
		justify-content: center;
		background: var(--panel-active-gradient-alt);
		color: var(--panel-active-text);
	}

	.service-card h3 {
		font-size: 1.15rem;
		margin-bottom: 0.65rem;
	}

	.service-card p {
		color: var(--text-muted);
		line-height: 1.6;
	}

	.service-link,
	.audience-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-weight: 700;
		color: var(--primary);
