<script>
	// Installation toggle logic
	const toggles = document.querySelectorAll(".installation-toggle");
	toggles.forEach((toggle) => {
		toggle.addEventListener("click", () => {
			toggle.classList.toggle("active");
			const basePrice = parseInt(
				toggle.getAttribute("data-base-price") || "0",
			);
			const finalPriceEl = toggle
				.closest(".group")
				?.querySelector(".final-price");

			if (finalPriceEl) {
				const isAuto = toggle.classList.contains("active");
				const total = basePrice + (isAuto ? 360 : 0);
				finalPriceEl.textContent = total.toLocaleString() + " Br";

				if (isAuto) {
					finalPriceEl.classList.add("pulse");
					setTimeout(
						() => finalPriceEl.classList.remove("pulse"),
						400,
					);
				}
			}
		});
	});
</script>

