---
import Layout from "../layouts/Layout.astro";
import FeaturedArticles from "../components/blog/FeaturedArticles.astro";
import HomeBrandStrip from "../components/home/HomeBrandStrip.astro";
import HomeBusiness from "../components/home/HomeBusiness.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeInstallationOffer from "../components/home/HomeInstallationOffer.astro";
import HomeIntentGrid from "../components/home/HomeIntentGrid.astro";
import HomeMobileActions from "../components/home/HomeMobileActions.astro";
import HomeQuickPick from "../components/home/HomeQuickPick.astro";
import HomeTrust from "../components/home/HomeTrust.astro";
import ProductGroup from "../components/ProductGroup.astro";
import { HOMEPAGE_ANALYTICS_EVENTS } from "../config/homepage";
import { normalizePhoneForTel, SITE_CONFIG } from "../config";
import {
    getGlobalConfig,
    getInstallationPricingInfo,
    getPublicBrands,
    resolveImageUrl,
} from "../utils/api";
import { formatBrandProductCount, getBrandConfig } from "../utils/brands";

export const prerender = true;

interface PublicBrand {
    title: string;
    slug: string;
    logo_url?: string | null;
    products_count: number;
}

const [{ minBundlePrice }, publicBrands, globalConfig] = await Promise.all([
    getInstallationPricingInfo(),
    getPublicBrands() as Promise<PublicBrand[]>,
    getGlobalConfig(),
]);

const phoneClean =
    normalizePhoneForTel(globalConfig["phone"] || SITE_CONFIG.phone) ||
    SITE_CONFIG.phoneClean;

const homepageBrands = publicBrands
    .filter((brand) => Number(brand.products_count || 0) > 0)
    .slice(0, 6)
    .map((brand) => ({
        title: brand.title,
        slug: brand.slug,
        logo: brand.logo_url
            ? resolveImageUrl(brand.logo_url)
            : getBrandConfig(brand.slug).logo || "",
        productCountLabel: formatBrandProductCount(brand.products_count),
        initials: brand.title.trim().slice(0, 2).toUpperCase(),
    }));
---

<Layout
    title="Кондиционеры в Витебске"
    description="Кондиционеры в Витебске: подбор моделей, продажа, монтаж своего оборудования, обслуживание и ремонт для дома и бизнеса."
>
    <HomeHero />
    <HomeIntentGrid />
    <HomeQuickPick />

    <section class="home-products" aria-label="Кондиционеры в наличии">
        <div class="container">
            <ProductGroup
                title="Кондиционеры в наличии в Витебске"
                subtitle="Модели с текущим остатком: сравните площадь, тип компрессора, обогрев и цену с монтажом."
                headingLevel={2}
                vitebskFeatured={true}
                limit={6}
                fitCheckHref="/contacts/#contact-form"
                fitCheckAnalyticsEvent={HOMEPAGE_ANALYTICS_EVENTS.productFit}
            />
        </div>
    </section>

    <HomeInstallationOffer minBundlePrice={minBundlePrice} />
    <HomeTrust />
    <HomeBusiness />
    <HomeBrandStrip brands={homepageBrands} />
    <FeaturedArticles />
    <HomeMobileActions phoneClean={phoneClean} />
</Layout>

<style>
    .home-products {
        padding: 4.5rem 0 1rem;
        background: var(--surface);
        border-top: 1px solid var(--border);
    }

    @media (max-width: 640px) {
        .home-products {
            padding-top: 3.5rem;
        }
    }
</style>
