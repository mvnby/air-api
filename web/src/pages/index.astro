		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0;
	}

	.hero-visual-copy {
		display: grid;
		gap: 1rem;
	}

	.eyebrow,
	.section-kicker {
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--primary);
	}

