		grid-template-columns: minmax(0, 1fr) minmax(220px, 0.72fr);
	}

	.offer-copy {
		padding: 2rem;
		display: grid;
		gap: 1rem;
	}

	.offer-copy h2 {
		font-size: clamp(2rem, 2.8vw, 2.8rem);
		line-height: 1.04;
		text-wrap: balance;
	}

	.offer-text {
		color: var(--text-muted);
		line-height: 1.7;
	}

	.offer-discount-note {
		display: inline-flex;
		width: fit-content;
		max-width: 100%;
		padding: 0.72rem 0.9rem;
		border-radius: 1rem;
		background: var(--success-bg);
		color: var(--success-text);
		font-weight: 700;
		line-height: 1.45;
		overflow-wrap: anywhere;
	}

	.offer-list {
		display: grid;
		gap: 0.8rem;
