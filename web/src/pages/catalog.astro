---
import Layout from "../layouts/Layout.astro";
import { getCatalog } from "../utils/api";

const { searchParams } = Astro.url;
const page = searchParams.get("page") || "1";
const sort = searchParams.get("sort") || "newest";

const data = await getCatalog({ page, limit: 12, sort });
const products = data.items || [];
const meta = data.meta || { total: 0, page: 1, limit: 12, pages: 1 };
---

<Layout title="Каталог">
    <div class="container catalog-page">
        <header class="catalog-header">
            <div class="breadcrumb">
                <a href="/">Главная</a>
                <span class="sep">/</span>
                <span>Каталог</span>
            </div>
            <h1>Каталог продукции</h1>
            <p>Найдено товаров: <span class="count">{meta.total}</span></p>
        </header>

        <div class="catalog-layout">
            <aside class="filters-sidebar">
                <div class="filter-card card">
                    <div class="filter-group">
                        <h5>Бренд</h5>
                        <div class="checkbox-list">
                            <label><input type="checkbox" /> Chigo</label>
                            <label><input type="checkbox" /> Mitsubishi</label>
                            <label><input type="checkbox" /> Gree</label>
                            <label><input type="checkbox" /> Haier</label>
                        </div>
                    </div>

                    <div class="filter-group">
                        <h5>Площадь (м²)</h5>
                        <div class="range-inputs">
                            <input type="number" placeholder="От" />
                            <input type="number" placeholder="До" />
                        </div>
                    </div>

                    <div class="filter-group">
                        <h5>Тип системы</h5>
                        <div class="checkbox-list">
                            <label><input type="checkbox" /> Инверторные</label>
                            <label
                                ><input type="checkbox" /> Неинверторные</label
                            >
                            <label><input type="checkbox" /> Мульти-сплит</label
                            >
                        </div>
                    </div>
                </div>
            </aside>

            <main class="products-area">
                <div class="sorting-bar">
                    <div class="sort-options">
                        <span>Сортировать:</span>
                        <select>
                            <option value="newest">Сначала новые</option>
                            <option value="price_asc">Дешевле</option>
                            <option value="price_desc">Дороже</option>
                        </select>
                    </div>
                </div>

                {
                    products.length > 0 ? (
                        <div class="grid">
                            {products.map((product) => (
                                <a
                                    href={`/product/${product.slug}`}
                                    class="product-item card group"
                                >
                                    <div class="p-img-box">
                                        <img
                                            src={
                                                product.main_image ||
                                                "/placeholder.jpg"
                                            }
                                            alt={product.title}
                                        />
                                        <div class="p-badge-list">
                                            {product.is_inverter && (
                                                <span class="badge small">
                                                    Инвертор
                                                </span>
                                            )}
                                        </div>
                                    </div>
                                    <div class="p-info">
                                        <span class="p-area-info">
                                            {product.area} м²
                                        </span>
                                        <h4>{product.title}</h4>
                                        <div class="p-footer">
                                            <span class="final-price">
                                                {product.price.toLocaleString()}{" "}
                                                Br
                                            </span>
                                            <div class="add-btn micro">
                                                <span class="material-icons-round">
                                                    shopping_cart
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            ))}
                        </div>
                    ) : (
                        <div class="empty-status card">
                            <span class="material-icons-round large">
                                search_off
                            </span>
                            <h3>Товары не найдены</h3>
                            <p>
                                Попробуйте сбросить фильтры или выбрать другие
                                параметры.
                            </p>
                        </div>
                    )
                }

                {
                    meta.pages > 1 && (
                        <div class="pagination">
                            {Array.from(
                                { length: meta.pages },
                                (_, i) => i + 1,
                            ).map((p) => (
                                <a
                                    href={`/catalog?page=${p}`}
                                    class={`page-link ${Number(page) === p ? "active" : ""}`}
                                >
                                    {p}
                                </a>
                            ))}
                        </div>
                    )
                }
            </main>
        </div>
    </div>
</Layout>

<style>
    .catalog-page {
        padding: 3rem 0;
    }
    .catalog-header {
        margin-bottom: 3.5rem;
    }
    .breadcrumb {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 500;
    }
    .breadcrumb a:hover {
        color: var(--primary);
    }
    .sep {
        opacity: 0.5;
    }
    .catalog-header h1 {
        font-size: 3rem;
        margin-bottom: 0.5rem;
        font-weight: 800;
    }
    .count {
        font-weight: 700;
        color: var(--primary);
    }

    .catalog-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 3.5rem;
        align-items: start;
    }

    /* Filters */
    .filter-card {
        padding: 2rem;
        position: sticky;
        top: 100px;
    }
    .filter-group {
        margin-bottom: 2.5rem;
    }
    .filter-group:last-child {
        margin-bottom: 0;
    }
    .filter-group h5 {
        font-size: 1rem;
        margin-bottom: 1.25rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text);
    }

    .checkbox-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .checkbox-list label {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        font-size: 0.95rem;
        color: var(--text-muted);
        transition: color 0.2s;
    }
    .checkbox-list label:hover {
        color: var(--text);
    }
    .checkbox-list input[type="checkbox"] {
        width: 18px;
        height: 18px;
        border-radius: 4px;
        accent-color: var(--primary);
    }

    .range-inputs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }
    .range-inputs input {
        width: 100%;
        padding: 0.75rem;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--text);
        font-size: 0.9rem;
    }

    /* Sorting Bar */
    .sorting-bar {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 2rem;
    }
    .sort-options {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-muted);
    }
    .sort-options select {
        border: none;
        background: transparent;
        color: var(--text);
        font-weight: 700;
        cursor: pointer;
        padding-right: 1.5rem;
    }

    /* Grid */
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 2rem;
    }
    .product-item {
        padding: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .p-img-box {
        height: 200px;
        background: var(--bg);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        position: relative;
    }
    .p-img-box img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        transition: transform 0.4s;
    }
    .product-item:hover .p-img-box img {
        transform: scale(1.1);
    }
    .p-badge-list {
        position: absolute;
        top: 1rem;
        left: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .p-info {
        padding: 1.5rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .p-area-info {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--primary);
        text-transform: uppercase;
        margin-bottom: 0.5rem;
        display: block;
    }
    .p-info h4 {
        font-size: 1.125rem;
        margin-bottom: 1.5rem;
        line-height: 1.4;
        flex: 1;
    }

    .p-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
    }
    .final-price {
        font-size: 1.25rem;
        font-weight: 800;
    }

    .add-btn.micro {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        box-shadow: 0 4px 6px -1px var(--primary-dark);
    }
    .add-btn .material-icons-round {
        font-size: 1.2rem;
    }

    .empty-status {
        text-align: center;
        padding: 5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }
    .large {
        font-size: 4rem;
        color: var(--text-muted);
        opacity: 0.5;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 5rem;
    }
    .page-link {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: var(--surface);
        border: 1px solid var(--border);
        font-weight: 700;
        transition: all 0.2s;
    }
    .page-link:hover {
        border-color: var(--primary);
        color: var(--primary);
        transform: translateY(-2px);
    }
    .page-link.active {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
        box-shadow: 0 10px 15px -3px rgba(0, 127, 128, 0.3);
    }

    @media (max-width: 1024px) {
        .catalog-layout {
            grid-template-columns: 1fr;
        }
        .filters-sidebar {
            display: none;
        }
    }
</style>
