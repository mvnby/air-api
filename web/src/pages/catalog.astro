---
import Layout from "../layouts/Layout.astro";
import CatalogApp from "../components/CatalogApp.vue";
import { getCatalog } from "../utils/api";

const { searchParams } = Astro.url;
const page = searchParams.get("page") || "1";
const sort = searchParams.get("sort") || "newest";
const tagSlugsRaw = searchParams.get("tag_slugs");
const is_inverter = searchParams.get("is_inverter");
const area_min = searchParams.get("area_min");
let area_max = searchParams.get("area_max");

// Smart Default: if no area/inverter/tags specified, default to area_max=29
if (!tagSlugsRaw && !is_inverter && !area_min && !area_max) {
    area_max = "29";
}

let tag_slugs: string[] = [];
if (tagSlugsRaw) {
    tag_slugs = tagSlugsRaw
        .split(",")
        .map((s) => s.trim())
        .filter(Boolean);
}

// Enforce 'wall' tag if no specific type is requested (Simple logic: just always add 'wall' for now as per user request to hide semi-prom)
// Or better: check if user requested a different type. If not, add wall.
// For now, I'll just append 'wall' if it's not present, assuming this page is for Wall units primarily.
if (!tag_slugs.includes("wall")) {
    tag_slugs.push("wall");
}

interface Product {
    title: string;
    price: number;
    slug: string;
    main_image?: string;
    description?: string;
    is_inverter?: boolean;
    area?: number;
    badges?: Array<{ text: string; class?: string }>;
    tags?: Array<{
        title: string;
        slug: string;
        is_public: boolean;
        group?: {
            slug: string;
            is_public: boolean;
        };
    }>;
}

const data = await getCatalog({
    page,
    limit: 12,
    sort,
    tag_slugs,
    is_inverter:
        is_inverter === "true"
            ? true
            : is_inverter === "false"
              ? false
              : undefined,
    area_min: area_min ? parseInt(area_min) : undefined,
    area_max: area_max ? parseInt(area_max) : undefined,
});
const products = (data.items || []) as Product[];
const meta = data.meta || { total: 0, page: 1, limit: 12, pages: 1 };
---

<Layout title="Каталог кондиционеров в Витебске">
    <div class="container catalog-page">
        <CatalogApp client:load initialProducts={products} initialMeta={meta} />
    </div>
</Layout>

<style>
    .catalog-page {
        padding: 2rem 1.5rem; /* Added horizontal padding */
        max-width: 1400px; /* Optional: slightly wider for catalog if needed, or keep standard container */
        margin: 0 auto;
    }
    .catalog-header {
        margin-bottom: 2rem;
    }
    .breadcrumb {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 500;
    }
    .breadcrumb a:hover {
        color: var(--primary);
    }
    .sep {
        opacity: 0.5;
    }
    .catalog-header h1 {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        font-weight: 800;
        line-height: 1.1;
    }
    .count {
        font-weight: 700;
        color: var(--primary);
    }

    /* Filters Bar */
    .filters-bar {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
        overflow-x: auto;
        padding-bottom: 0.5rem; /* Space for scrollbar if needed */
        scrollbar-width: thin;
    }

    .filter-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.25rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 99px;
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--text);
        white-space: nowrap;
        transition: all 0.2s;
        cursor: pointer;
        text-decoration: none;
    }

    .filter-btn:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: rgba(0, 127, 128, 0.05);
    }

    .filter-btn.active {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
    }

    .filter-btn.primary {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
    }
    .filter-btn.primary:hover {
        background: var(--primary-dark);
    }

    .icon {
        font-size: 1.2rem;
    }

    /* Main Area */
    .products-area {
        width: 100%;
    }

    /* Grid */
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 2rem;
    }

    .empty-status {
        text-align: center;
        padding: 5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }
    .large {
        font-size: 4rem;
        color: var(--text-muted);
        opacity: 0.5;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 5rem;
    }
    .page-link {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: var(--surface);
        border: 1px solid var(--border);
        font-weight: 700;
        transition: all 0.2s;
    }
    .page-link:hover {
        border-color: var(--primary);
        color: var(--primary);
        transform: translateY(-2px);
    }
    .page-link.active {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
        box-shadow: 0 10px 15px -3px rgba(0, 127, 128, 0.3);
    }

    @media (max-width: 768px) {
        .filters-bar {
            padding-bottom: 1rem;
        }
    }
</style>
