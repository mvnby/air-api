---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getCatalog } from "../utils/api";

const { searchParams } = Astro.url;
const page = searchParams.get("page") || "1";
const sort = searchParams.get("sort") || "newest"; // "newest", "price_asc", "price_desc"
const tagSlugsRaw = searchParams.get("tag_slugs");

// Handle tag_slugs which might be "tag1,tag2" or just "tag1"
// Note: If multiple ?tag_slugs=a&tag_slugs=b are used, Astro/Vite might handle them differently,
// but for the link we generated we use comma separation.
let tag_slugs: string[] | null = null;
if (tagSlugsRaw) {
    tag_slugs = tagSlugsRaw
        .split(",")
        .map((s) => s.trim())
        .filter(Boolean);
}

const data = await getCatalog({
    page,
    limit: 12,
    sort,
    tag_slugs, // Pass array to api utils
});
const products = data.items || [];
const meta = data.meta || { total: 0, page: 1, limit: 12, pages: 1 };
---

<Layout title="Каталог">
    <div class="container catalog-page">
        <header class="catalog-header">
            <div class="breadcrumb">
                <a href="/">Главная</a>
                <span class="sep">/</span>
                <span>Каталог</span>
            </div>
            <h1>Каталог продукции</h1>
            <p>Найдено товаров: <span class="count">{meta.total}</span></p>
        </header>

        <div class="catalog-layout">
            <aside class="filters-sidebar">
                <div class="filter-card card">
                    <div class="filter-group">
                        <h5>Бренд</h5>
                        <div class="checkbox-list">
                            <label><input type="checkbox" /> Chigo</label>
                            <label><input type="checkbox" /> Mitsubishi</label>
                            <label><input type="checkbox" /> Gree</label>
                            <label><input type="checkbox" /> Haier</label>
                        </div>
                    </div>

                    <div class="filter-group">
                        <h5>Площадь (м²)</h5>
                        <div class="range-inputs">
                            <input type="number" placeholder="От" />
                            <input type="number" placeholder="До" />
                        </div>
                    </div>

                    <div class="filter-group">
                        <h5>Тип системы</h5>
                        <div class="checkbox-list">
                            <label><input type="checkbox" /> Инверторные</label>
                            <label
                                ><input type="checkbox" /> Неинверторные</label
                            >
                            <label><input type="checkbox" /> Мульти-сплит</label
                            >
                        </div>
                    </div>
                </div>
            </aside>

            <main class="products-area">
                <div class="sorting-bar">
                    <div class="sort-options">
                        <span>Сортировать:</span>
                        <select>
                            <option value="newest">Сначала новые</option>
                            <option value="price_asc">Дешевле</option>
                            <option value="price_desc">Дороже</option>
                        </select>
                    </div>
                </div>

                {
                    products.length > 0 ? (
                        <div class="grid">
                            {products.map((product) => (
                                <ProductCard
                                    product={product}
                                    showInstallation={true}
                                />
                            ))}
                        </div>
                    ) : (
                        <div class="empty-status card">
                            <span class="material-icons-round large">
                                search_off
                            </span>
                            <h3>Товары не найдены</h3>
                            <p>
                                Попробуйте сбросить фильтры или выбрать другие
                                параметры.
                            </p>
                        </div>
                    )
                }

                {
                    meta.pages > 1 && (
                        <div class="pagination">
                            {Array.from(
                                { length: meta.pages },
                                (_, i) => i + 1,
                            ).map((p) => (
                                <a
                                    href={`/catalog?page=${p}`}
                                    class={`page-link ${Number(page) === p ? "active" : ""}`}
                                >
                                    {p}
                                </a>
                            ))}
                        </div>
                    )
                }
            </main>
        </div>
    </div>
</Layout>

<style>
    .catalog-page {
        padding: 3rem 0;
    }
    .catalog-header {
        margin-bottom: 3.5rem;
    }
    .breadcrumb {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 500;
    }
    .breadcrumb a:hover {
        color: var(--primary);
    }
    .sep {
        opacity: 0.5;
    }
    .catalog-header h1 {
        font-size: 3rem;
        margin-bottom: 0.5rem;
        font-weight: 800;
    }
    .count {
        font-weight: 700;
        color: var(--primary);
    }

    .catalog-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 3.5rem;
        align-items: start;
    }

    /* Filters */
    .filter-card {
        padding: 2rem;
        position: sticky;
        top: 100px;
    }
    .filter-group {
        margin-bottom: 2.5rem;
    }
    .filter-group:last-child {
        margin-bottom: 0;
    }
    .filter-group h5 {
        font-size: 1rem;
        margin-bottom: 1.25rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text);
    }

    .checkbox-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .checkbox-list label {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        font-size: 0.95rem;
        color: var(--text-muted);
        transition: color 0.2s;
    }
    .checkbox-list label:hover {
        color: var(--text);
    }
    .checkbox-list input[type="checkbox"] {
        width: 18px;
        height: 18px;
        border-radius: 4px;
        accent-color: var(--primary);
    }

    .range-inputs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }
    .range-inputs input {
        width: 100%;
        padding: 0.75rem;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--text);
        font-size: 0.9rem;
    }

    /* Sorting Bar */
    .sorting-bar {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 2rem;
    }
    .sort-options {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-muted);
    }
    .sort-options select {
        border: none;
        background: transparent;
        color: var(--text);
        font-weight: 700;
        cursor: pointer;
        padding-right: 1.5rem;
    }

    /* Grid */
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 2rem;
    }

    .empty-status {
        text-align: center;
        padding: 5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }
    .large {
        font-size: 4rem;
        color: var(--text-muted);
        opacity: 0.5;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 5rem;
    }
    .page-link {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: var(--surface);
        border: 1px solid var(--border);
        font-weight: 700;
        transition: all 0.2s;
    }
    .page-link:hover {
        border-color: var(--primary);
        color: var(--primary);
        transform: translateY(-2px);
    }
    .page-link.active {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
        box-shadow: 0 10px 15px -3px rgba(0, 127, 128, 0.3);
    }

    @media (max-width: 1024px) {
        .catalog-layout {
            grid-template-columns: 1fr;
        }
        .filters-sidebar {
            display: none;
        }
    }
</style>
