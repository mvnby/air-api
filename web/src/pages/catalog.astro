---
import Layout from "../layouts/Layout.astro";
import CatalogApp from "../components/CatalogApp.vue";
import { getCatalog } from "../utils/api";
import { matchVirtualCategoryByFilters } from "../utils/virtual-category";
import {
    VIRTUAL_CATEGORIES,
    type CatalogSort,
} from "../config/virtual-categories";

const { searchParams } = Astro.url;
const hasQueryParams = Array.from(searchParams.keys()).length > 0;
const page = searchParams.get("page") || "1";
const sortRaw = searchParams.get("sort") || "newest";
const allowedSorts: CatalogSort[] = [
    "newest",
    "price_asc",
    "price_desc",
    "area_asc",
    "area_desc",
];
const sort: CatalogSort = allowedSorts.includes(sortRaw as CatalogSort)
    ? (sortRaw as CatalogSort)
    : "newest";
const tagSlugsRaw = searchParams.getAll("tag_slugs");
const isInverterRaw = searchParams.get("is_inverter");
const hasWifiRaw = searchParams.get("has_wifi");
const heatingMinRaw = searchParams.get("heating_min");
const areaMinRaw = searchParams.get("area_min");
let areaMaxRaw = searchParams.get("area_max");

// Smart Default: if no area/inverter/tags specified, default to area_max=29
if (tagSlugsRaw.length === 0 && !isInverterRaw && !hasWifiRaw && !heatingMinRaw && !areaMinRaw && !areaMaxRaw) {
    areaMaxRaw = "29";
}

const userTagSlugs = tagSlugsRaw
    .flatMap((value) => value.split(","))
    .map((s) => s.trim())
    .filter(Boolean);

const parsedIsInverter =
    isInverterRaw === "true"
        ? true
        : isInverterRaw === "false"
          ? false
          : undefined;
const parsedHasWifi =
    hasWifiRaw === "true"
        ? true
        : hasWifiRaw === "false"
          ? false
          : undefined;

const parsedAreaMin = areaMinRaw ? parseInt(areaMinRaw, 10) : undefined;
const parsedAreaMax = areaMaxRaw ? parseInt(areaMaxRaw, 10) : undefined;
const parsedHeatingMin = heatingMinRaw ? parseInt(heatingMinRaw, 10) : undefined;
const tag_slugs: string[] = [...userTagSlugs];

let canonicalPath = "/catalog";
let robotsValue: string | undefined;

if (hasQueryParams) {
    const matchedVirtual = matchVirtualCategoryByFilters({
        sort,
        tag_slugs: userTagSlugs,
        is_inverter: parsedIsInverter,
        has_wifi: parsedHasWifi,
        heating_min: parsedHeatingMin,
        area_min: parsedAreaMin,
        area_max: parsedAreaMax,
    });
    if (matchedVirtual) {
        canonicalPath = `/catalog/${matchedVirtual.slug}`;
    }
    robotsValue = "noindex,follow";
}

interface Product {
    title: string;
    price: number;
    slug: string;
    main_image?: string;
    description?: string;
    vitebsk_qty?: number;
    minsk_qty?: number;
    availability_status?: string | null;
    is_inverter?: boolean;
    area?: number;
    badges?: Array<{ text: string; class?: string }>;
    tags?: Array<{
        title: string;
        slug: string;
        is_public: boolean;
        sort_order?: number;
        group?: {
            slug: string;
            is_public: boolean;
        };
    }>;
}

const data = await getCatalog({
    page,
    limit: 100,
    sort,
    tag_slugs,
    is_inverter: parsedIsInverter,
    has_wifi: parsedHasWifi,
    heating_min: parsedHeatingMin,
    area_min: parsedAreaMin,
    area_max: parsedAreaMax,
});
const products = (data.items || []) as Product[];
const meta = data.meta || { total: 0, page: 1, limit: 12, pages: 1 };
---

<Layout
    title="Каталог кондиционеров в Витебске"
    canonical={canonicalPath}
    robots={robotsValue}
>
    <div class="container catalog-page">
        <CatalogApp client:load initialProducts={products} initialMeta={meta} />
    </div>
    <script is:inline define:vars={{ virtualCategories: VIRTUAL_CATEGORIES }}>
        (() => {
            if (typeof window === "undefined") return;

            const sp = new URLSearchParams(window.location.search);
            if (Array.from(sp.keys()).length === 0) return;

            const parseTags = () => {
                const tags = [];
                sp.getAll("tag_slugs").forEach((raw) => {
                    raw.split(",").forEach((tag) => {
                        const clean = tag.trim().toLowerCase();
                        if (clean) tags.push(clean);
                    });
                });
                return tags;
            };

            const normalizeTags = (tags) =>
                [...new Set(tags.filter((tag) => tag !== "wall"))].sort();

            const sortRaw = sp.get("sort") || "newest";
            const allowedSorts = [
                "newest",
                "price_asc",
                "price_desc",
                "area_asc",
                "area_desc",
            ];
            const sort = allowedSorts.includes(sortRaw) ? sortRaw : "newest";

            const toNumber = (value) => {
                if (!value) return undefined;
                const parsed = Number.parseInt(value, 10);
                return Number.isFinite(parsed) ? parsed : undefined;
            };

            const normalizedInput = {
                sort,
                tag_slugs: normalizeTags(parseTags()),
                is_inverter:
                    sp.get("is_inverter") === "true"
                        ? true
                        : sp.get("is_inverter") === "false"
                          ? false
                          : undefined,
                has_wifi:
                    sp.get("has_wifi") === "true"
                        ? true
                        : sp.get("has_wifi") === "false"
                          ? false
                          : undefined,
                heating_min: toNumber(sp.get("heating_min")),
                area_min: toNumber(sp.get("area_min")),
                area_max: toNumber(sp.get("area_max")),
            };

            const matched = virtualCategories.find((category) => {
                const normalizedCategory = {
                    sort: category.filters.sort || "newest",
                    tag_slugs: normalizeTags(category.filters.tag_slugs || []),
                    is_inverter:
                        typeof category.filters.is_inverter === "boolean"
                            ? category.filters.is_inverter
                            : undefined,
                    has_wifi:
                        typeof category.filters.has_wifi === "boolean"
                            ? category.filters.has_wifi
                            : undefined,
                    heating_min: category.filters.heating_min,
                    area_min: category.filters.area_min,
                    area_max: category.filters.area_max,
                };

                return (
                    normalizedInput.sort === normalizedCategory.sort &&
                    normalizedInput.is_inverter ===
                        normalizedCategory.is_inverter &&
                    normalizedInput.has_wifi === normalizedCategory.has_wifi &&
                    normalizedInput.heating_min === normalizedCategory.heating_min &&
                    normalizedInput.area_min === normalizedCategory.area_min &&
                    normalizedInput.area_max === normalizedCategory.area_max &&
                    normalizedInput.tag_slugs.length ===
                        normalizedCategory.tag_slugs.length &&
                    normalizedInput.tag_slugs.every(
                        (tag, idx) => tag === normalizedCategory.tag_slugs[idx],
                    )
                );
            });

            const canonicalPath = matched ? `/catalog/${matched.slug}` : "/catalog";
            const canonicalUrl = new URL(
                canonicalPath,
                window.location.origin,
            ).toString();

            const canonicalNode = document.querySelector('link[rel="canonical"]');
            if (canonicalNode) {
                canonicalNode.setAttribute("href", canonicalUrl);
            }

            let robotsNode = document.querySelector('meta[name="robots"]');
            if (!robotsNode) {
                robotsNode = document.createElement("meta");
                robotsNode.setAttribute("name", "robots");
                document.head.appendChild(robotsNode);
            }
            robotsNode.setAttribute("content", "noindex,follow");
        })();
    </script>
</Layout>

<style>
    .catalog-page {
        padding: 2rem 1.5rem; /* Added horizontal padding */
        max-width: 1400px; /* Optional: slightly wider for catalog if needed, or keep standard container */
        margin: 0 auto;
    }
    .catalog-header {
        margin-bottom: 2rem;
    }
    .breadcrumb {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 500;
    }
    .breadcrumb a:hover {
        color: var(--primary);
    }
    .sep {
        opacity: 0.5;
    }
    .catalog-header h1 {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        font-weight: 800;
        line-height: 1.1;
    }
    .count {
        font-weight: 700;
        color: var(--primary);
    }

    /* Filters Bar */
    .filters-bar {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
        overflow-x: auto;
        padding-bottom: 0.5rem; /* Space for scrollbar if needed */
        scrollbar-width: thin;
    }

    .filter-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.25rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 99px;
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--text);
        white-space: nowrap;
        transition: all 0.2s;
        cursor: pointer;
        text-decoration: none;
    }

    .filter-btn:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: rgba(0, 127, 128, 0.05);
    }

    .filter-btn.active {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
    }

    .filter-btn.primary {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
    }
    .filter-btn.primary:hover {
        background: var(--primary-dark);
    }

    .icon {
        font-size: 1.2rem;
    }

    /* Main Area */
    .products-area {
        width: 100%;
    }

    /* Grid */
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 2rem;
    }

    .empty-status {
        text-align: center;
        padding: 5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }
    .large {
        font-size: 4rem;
        color: var(--text-muted);
        opacity: 0.5;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 5rem;
    }
    .page-link {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: var(--surface);
        border: 1px solid var(--border);
        font-weight: 700;
        transition: all 0.2s;
    }
    .page-link:hover {
        border-color: var(--primary);
        color: var(--primary);
        transform: translateY(-2px);
    }
    .page-link.active {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
        box-shadow: 0 10px 15px -3px rgba(0, 127, 128, 0.3);
    }

    @media (max-width: 768px) {
        .filters-bar {
            padding-bottom: 1rem;
        }
    }
</style>
