---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getCatalog } from "../utils/api";

const { searchParams } = Astro.url;
const page = searchParams.get("page") || "1";
const sort = searchParams.get("sort") || "newest";
const tagSlugsRaw = searchParams.get("tag_slugs");
const is_inverter = searchParams.get("is_inverter");
const area_max = searchParams.get("area_max");

let tag_slugs: string[] = [];
if (tagSlugsRaw) {
    tag_slugs = tagSlugsRaw
        .split(",")
        .map((s) => s.trim())
        .filter(Boolean);
}

// Enforce 'wall' tag if no specific type is requested (Simple logic: just always add 'wall' for now as per user request to hide semi-prom)
// Or better: check if user requested a different type. If not, add wall.
// For now, I'll just append 'wall' if it's not present, assuming this page is for Wall units primarily.
if (!tag_slugs.includes("wall")) {
    tag_slugs.push("wall");
}

interface Product {
    title: string;
    price: number;
    slug: string;
    main_image?: string;
    description?: string;
    is_inverter?: boolean;
    area?: number;
    badges?: Array<{ text: string; class?: string }>;
    tags?: Array<{
        title: string;
        slug: string;
        is_public: boolean;
        group?: {
            slug: string;
            is_public: boolean;
        };
    }>;
}

const data = await getCatalog({
    page,
    limit: 12,
    sort,
    tag_slugs,
    is_inverter:
        is_inverter === "true"
            ? true
            : is_inverter === "false"
              ? false
              : undefined,
    area_max: area_max ? parseInt(area_max) : undefined,
});
const products = (data.items || []) as Product[];
const meta = data.meta || { total: 0, page: 1, limit: 12, pages: 1 };

// Helper to toggle URL params
function getUrl(params: Record<string, string | null>) {
    const url = new URL(Astro.request.url);
    const sp = url.searchParams;

    // Process new params
    Object.entries(params).forEach(([key, value]) => {
        if (value === null) {
            sp.delete(key);
        } else {
            sp.set(key, value);
        }
    });

    // Handle tag toggling separately if key is 'toggle_tag'
    // Handle tag toggling separately if key is 'toggle_tag'
    if (params.toggle_tag) {
        const tagsToToggle = params.toggle_tag.split(",").map((t) => t.trim());
        sp.delete("toggle_tag"); // Clean up

        let currentTags = sp.get("tag_slugs")
            ? sp.get("tag_slugs")!.split(",")
            : [];

        // Check if ALL tags to toggle are currently present
        const allPresent = tagsToToggle.every((t) => currentTags.includes(t));

        if (allPresent) {
            // If all are present, remove them all (toggle off behavior)
            currentTags = currentTags.filter((t) => !tagsToToggle.includes(t));
        } else {
            // If any is missing, add/ensure all are present (activates the filter set)
            tagsToToggle.forEach((t) => {
                if (!currentTags.includes(t)) currentTags.push(t);
            });
        }

        if (currentTags.length > 0) {
            sp.set("tag_slugs", currentTags.join(","));
        } else {
            sp.delete("tag_slugs");
        }
    }

    return url.pathname + url.search;
}
---

<Layout title="Каталог кондиционеров в Витебске">
    <div class="container catalog-page">
        <header class="catalog-header">
            <div class="breadcrumb">
                <a href="/">Главная</a>
                <span class="sep">/</span>
                <span>Каталог</span>
            </div>
            <h1>Каталог кондиционеров в Витебске</h1>
            <p style="max-width: 600px; color: var(--text-muted);">
                Современные системы кондиционирования для идеального климата в
                вашем доме и офисе.
            </p>
        </header>

        <!-- Top Filters Bar -->
        <div class="filters-bar">
            <!-- Inverter -->
            <a
                href={getUrl({
                    is_inverter: is_inverter === "true" ? null : "true",
                })}
                class={`filter-btn ${is_inverter === "true" ? "active" : ""}`}
            >
                <span class="material-icons-round icon">equalizer</span>
                Инвертор
            </a>

            <!-- Area 25m -->
            <a
                href={getUrl({ area_max: area_max === "25" ? null : "25" })}
                class={`filter-btn ${area_max === "25" ? "active" : ""}`}
            >
                <span class="material-icons-round icon">straighten</span>
                До 25 кв.м
            </a>

            <!-- Calculator Link -->
            <a
                href="/kak-vybrat-konditsioner"
                class="filter-btn"
                style="border-color: var(--primary); color: var(--primary);"
            >
                <span class="material-icons-round icon">calculate</span>
                Подбор
            </a>

            <!-- Heating -25/-30 -->
            <a
                href={getUrl({ toggle_tag: "winter-25,winter-30" })}
                class={`filter-btn ${tagSlugsRaw?.includes("winter-25") || tagSlugsRaw?.includes("winter-30") ? "active" : ""}`}
            >
                <span class="material-icons-round icon">ac_unit</span>
                Обогрев в мороз
            </a>

            <!-- WiFi -->
            <a
                href={getUrl({ toggle_tag: "wifi-builtin" })}
                class={`filter-btn ${tagSlugsRaw?.includes("wifi") ? "active" : ""}`}
            >
                <span class="material-icons-round icon">wifi</span>
                Wi-Fi модуль
            </a>

            <!-- Quiet -->
            <a
                href={getUrl({ toggle_tag: "noise-silent" })}
                class={`filter-btn ${tagSlugsRaw?.includes("noise-silent") ? "active" : ""}`}
            >
                <span class="material-icons-round icon">volume_off</span>
                Тихий режим
            </a>
        </div>

        <main class="products-area">
            {
                products.length > 0 ? (
                    <div class="grid">
                        {products.map((product) => (
                            <ProductCard
                                product={product}
                                showInstallation={true}
                            />
                        ))}
                    </div>
                ) : (
                    <div class="empty-status card">
                        <span class="material-icons-round large">
                            search_off
                        </span>
                        <h3>Товары не найдены</h3>
                        <p>Попробуйте изменить параметры поиска.</p>
                    </div>
                )
            }

            {
                meta.pages > 1 && (
                    <div class="pagination">
                        {Array.from(
                            { length: meta.pages },
                            (_, i) => i + 1,
                        ).map((p) => (
                            <a
                                href={getUrl({ page: String(p) })}
                                class={`page-link ${Number(page) === p ? "active" : ""}`}
                            >
                                {p}
                            </a>
                        ))}
                    </div>
                )
            }
        </main>
    </div>
</Layout>

<style>
    .catalog-page {
        padding: 2rem 1.5rem; /* Added horizontal padding */
        max-width: 1400px; /* Optional: slightly wider for catalog if needed, or keep standard container */
        margin: 0 auto;
    }
    .catalog-header {
        margin-bottom: 2rem;
    }
    .breadcrumb {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 500;
    }
    .breadcrumb a:hover {
        color: var(--primary);
    }
    .sep {
        opacity: 0.5;
    }
    .catalog-header h1 {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        font-weight: 800;
        line-height: 1.1;
    }
    .count {
        font-weight: 700;
        color: var(--primary);
    }

    /* Filters Bar */
    .filters-bar {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
        overflow-x: auto;
        padding-bottom: 0.5rem; /* Space for scrollbar if needed */
        scrollbar-width: thin;
    }

    .filter-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.25rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 99px;
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--text);
        white-space: nowrap;
        transition: all 0.2s;
        cursor: pointer;
        text-decoration: none;
    }

    .filter-btn:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: rgba(0, 127, 128, 0.05);
    }

    .filter-btn.active {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
    }

    .filter-btn.primary {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
    }
    .filter-btn.primary:hover {
        background: var(--primary-dark);
    }

    .icon {
        font-size: 1.2rem;
    }

    /* Main Area */
    .products-area {
        width: 100%;
    }

    /* Grid */
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 2rem;
    }

    .empty-status {
        text-align: center;
        padding: 5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }
    .large {
        font-size: 4rem;
        color: var(--text-muted);
        opacity: 0.5;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 5rem;
    }
    .page-link {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: var(--surface);
        border: 1px solid var(--border);
        font-weight: 700;
        transition: all 0.2s;
    }
    .page-link:hover {
        border-color: var(--primary);
        color: var(--primary);
        transform: translateY(-2px);
    }
    .page-link.active {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
        box-shadow: 0 10px 15px -3px rgba(0, 127, 128, 0.3);
    }

    @media (max-width: 768px) {
        .filters-bar {
            padding-bottom: 1rem;
        }
    }
</style>
