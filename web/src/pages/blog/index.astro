---
import Layout from "../../layouts/Layout.astro";
import ArticlePreview from "../../components/blog/ArticlePreview.astro";
import { getCollection } from "astro:content";

export const prerender = true;

// Получаем все статьи и сортируем по дате (сначала новые)
const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
    (a, b) => (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0),
);

const title = "Статьи о кондиционерах";
const description =
    "Практичные материалы о выборе, установке, обслуживании и ремонте кондиционеров.";
---

<Layout title={title} description={description}>
    <div class="pt-24 pb-16 sm:pt-32 sm:pb-24 bg-bg">
        <div class="container">
            <div class="max-w-3xl mx-auto text-center mb-16">
                <h1
                    class="text-4xl sm:text-5xl font-extrabold text-slate-900 dark:text-white mb-6 font-heading"
                >
                    Статьи о кондиционерах
                </h1>
                <p class="text-lg text-text-muted leading-relaxed">
                    Пишем простыми словами: как выбрать мощность, где заложить
                    трассу, когда чистить блок и на чем не стоит переплачивать.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {sortedPosts.map((post) => <ArticlePreview post={post} />)}
            </div>

            {
                sortedPosts.length === 0 && (
                    <div class="text-center py-20 bg-surface-100 rounded-2xl">
                        <span class="material-icons-round text-6xl text-text-muted mb-4">
                            article
                        </span>
                        <p class="text-xl text-text-muted">
                            Статей пока нет. Загляните позже!
                        </p>
                    </div>
                )
            }
        </div>
    </div>
</Layout>
