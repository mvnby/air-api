---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.vue";
import { getGlobalConfig } from "../utils/api";

export const prerender = true;

const config = await getGlobalConfig();
const phone = config["phone"] || "+375 (29) 000-00-00";
const email = config["email"] || "info@master-air.by";
const address = config["address"] || "г. Витебск, ул. Ленина, 54";
const workHours = config["work_hours"] || "Пн-Пт: 9:00 - 18:00";
---

<Layout title="Контакты" description="Свяжитесь с нами для консультации">
    <section class="page-header">
        <div class="container">
            <h1 class="gradient-text">Контакты</h1>
            <p class="breadcrumbs">Главная / Контакты</p>
        </div>
    </section>

    <section class="container contact-section">
        <div class="contact-grid">
            <div class="contact-info">
                <h2>Позвоните или оставьте заявку</h2>
                <p class="intro">
                    Подскажем по модели, монтажу, обслуживанию или ремонту.
                    Для монтажа обычно уточняем площадь комнаты, адрес или
                    район Витебска, доступ к наружному блоку и есть ли готовая
                    трасса.
                </p>

                <div class="info-list">
                    <div class="info-item">
                        <div class="icon-box">
                            <span class="material-icons-round">phone</span>
                        </div>
                        <div>
                            <h3>Телефон</h3>
                            <a href={`tel:${phone}`} class="js-track-phone"
                                >{phone}</a
                            >
                            <p class="sub">Ежедневно с 9:00 до 21:00</p>
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="icon-box">
                            <span class="material-icons-round">location_on</span
                            >
                        </div>
                        <div>
                            <h3>Офис</h3>
                            <p>{address}</p>
                            <p class="sub">{workHours}</p>
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="icon-box">
                            <span class="material-icons-round">email</span>
                        </div>
                        <div>
                            <h3>Email</h3>
                            <a href={`mailto:${email}`}>{email}</a>
                            <p class="sub">Для коммерческих предложений</p>
                        </div>
                    </div>
                </div>
            </div>

            <div id="contact-form" class="contact-form-wrapper">
                <ContactForm client:visible />
            </div>
        </div>
    </section>
</Layout>

<style>
    .page-header {
        background: var(--bg);
        padding: 3rem 0 0;
        margin-bottom: 0;
    }

    h1 {
        font-size: 3rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
    }

    .breadcrumbs {
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    .contact-section {
        margin-bottom: 6rem;
    }

    #contact-form {
        scroll-margin-top: 100px;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
    }

    .intro {
        font-size: 1.1rem;
        color: var(--text-muted);
        margin-bottom: 2.5rem;
        line-height: 1.6;
        max-width: 480px;
    }

    .info-list {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin-bottom: 3rem;
    }

    .info-item {
        display: flex;
        gap: 1.25rem;
    }

    .icon-box {
        width: 50px;
        height: 50px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: var(--primary);
    }

    .info-item h3 {
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .info-item a,
    .info-item p {
        font-size: 1.05rem;
        color: var(--text);
    }

    .info-item .sub {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 0.25rem;
    }

    @media (max-width: 900px) {
        .contact-grid {
            grid-template-columns: 1fr;
            gap: 3rem;
        }

        .contact-info {
            order: 2;
        }

        .contact-form-wrapper {
            order: 1;
        }
    }
</style>
