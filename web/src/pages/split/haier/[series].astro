---
import Layout from "../../../layouts/Layout.astro";
import ProductCard from "../../../components/ProductCard.astro";
import { getCatalogForSsg, getPublicBrandBySlug, resolveImageUrl } from "../../../utils/api";
import { buildCatalogItemListSchema } from "../../../utils/catalog-seo";
import { safeJsonLd } from "../../../utils/safe-json-ld.js";
import {
    LEGACY_HAIER_SERIES_PAGES,
    getLegacyHaierSeriesPage,
} from "../../../config/legacy-series-pages";

export const prerender = true;

export async function getStaticPaths() {
    return LEGACY_HAIER_SERIES_PAGES.map((page) => ({
        params: { series: page.slug },
        props: { seriesPage: page },
    }));
}

interface Props {
    seriesPage: (typeof LEGACY_HAIER_SERIES_PAGES)[number];
}

const { seriesPage: initialSeriesPage } = Astro.props as Props;
const seriesPage =
    initialSeriesPage || getLegacyHaierSeriesPage(Astro.params.series || "");

if (!seriesPage) {
    return Astro.redirect("/404");
}

const brand = await getPublicBrandBySlug(seriesPage.brandSlug);
const catalogData = await getCatalogForSsg({
    page: 1,
    limit: 8,
    sort: "recommended",
    brand_slugs: [seriesPage.brandSlug],
});
const products = catalogData.items || [];
const logoUrl = brand?.logo_url ? resolveImageUrl(brand.logo_url) : "";
const canonicalPath = `/split/haier/${seriesPage.slug}/`;
const catalogSchema = buildCatalogItemListSchema(products, Astro.url.origin);
---

<Layout
    title={seriesPage.seoTitle}
    description={seriesPage.seoDescription}
    image={logoUrl || undefined}
    canonical={canonicalPath}
>
    <script type="application/ld+json" set:html={safeJsonLd(catalogSchema)} />
    <main class="container legacy-series-page">
        <nav class="breadcrumb">
            <a href="/">Главная</a>
            <span class="sep">/</span>
            <a href="/brands/haier/">Haier</a>
            <span class="sep">/</span>
            <span>{seriesPage.seriesTitle}</span>
        </nav>

        <header class="series-header">
            <div class="series-copy">
                <p class="series-kicker">{seriesPage.brandTitle}</p>
                <h1 class="gradient-text">{seriesPage.h1}</h1>
                <p class="series-intro">{seriesPage.intro}</p>
                <a class="btn btn-primary" href="/brands/haier/">Все модели Haier</a>
            </div>
            <div class="series-logo" aria-label={`Логотип ${seriesPage.brandTitle}`}>
                {logoUrl ? <img src={logoUrl} alt={seriesPage.brandTitle} /> : <span>{seriesPage.brandTitle}</span>}
            </div>
        </header>

        {
            products.length > 0 && (
                <section class="series-products" aria-labelledby="series-products-title">
                    <div class="section-head">
                        <h2 id="series-products-title">Актуальные модели Haier</h2>
                        <p>Подберем ближайшую модель по площади, уровню шума, режимам и бюджету.</p>
                    </div>
                    <div class="catalog-grid">
                        {products.map((product: any) => (
                            <ProductCard
                                product={product}
                                variant="default"
                                showInstallation={true}
                                refreshProductOnMount={false}
                            />
                        ))}
                    </div>
                </section>
            )
        }
    </main>
</Layout>

<style>
    .legacy-series-page {
        padding: 2rem 1.5rem 3rem;
        max-width: 1200px;
        margin: 0 auto;
    }
    .breadcrumb {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 500;
        flex-wrap: wrap;
    }
    .breadcrumb a:hover {
        color: var(--primary);
    }
    .sep {
        opacity: 0.5;
    }
    .series-header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 180px;
        gap: 1.5rem;
        align-items: center;
        margin-bottom: 2.4rem;
    }
    .series-kicker {
        margin: 0 0 0.55rem;
        color: var(--primary);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .series-copy h1 {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        line-height: 1.1;
    }
    .series-intro {
        max-width: 760px;
        margin: 0.9rem 0 1.2rem;
        color: var(--text-muted);
        line-height: 1.7;
    }
    .series-logo {
        min-height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--panel-glass-bg);
        border: 1px solid var(--panel-glass-border);
        border-radius: 8px;
        box-shadow: var(--panel-glass-shadow);
        color: var(--primary);
        font-family: "Space Grotesk", sans-serif;
        font-size: 1.45rem;
        font-weight: 800;
    }
    .series-logo img {
        max-width: 132px;
        max-height: 78px;
        object-fit: contain;
    }
    .series-products {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }
    .section-head h2 {
        margin: 0;
        color: var(--text);
        font-family: "Space Grotesk", sans-serif;
        font-size: 1.35rem;
    }
    .section-head p {
        margin: 0.45rem 0 0;
        color: var(--text-muted);
    }
    .catalog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.3rem;
    }
    @media (max-width: 720px) {
        .series-header {
            grid-template-columns: 1fr;
        }
        .series-logo {
            min-height: 104px;
        }
    }
</style>
