---
import "../assets/index.css";
import { getGlobalConfig } from "../utils/api";
import { normalizePhoneForTel, SITE_CONFIG } from "../config";
import HeaderCart from "../components/cart/HeaderCart.vue";
import MobileMenu from "../components/ui/MobileMenu.vue";
import ToastContainer from "../components/ui/ToastContainer.vue";
import SEOHead from "../components/seo/SEOHead.astro";

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: "website" | "product" | "article";
	price?: number;
	currency?: string;
	articleDate?: string;
	canonical?: string;
	robots?: string;
}
// Читаем переменную из окружения (она прокидывается скриптом)
const siteUrl = import.meta.env.PUBLIC_SITE_URL || "";
const isDev = siteUrl.includes("dev.mvn.by");

const {
	title,
	description = "Кондиционеры в Витебске. Продажа, монтаж, обслуживание",
	image,
	type = "website",
	price,
	currency,
	articleDate,
	canonical,
	robots,
} = Astro.props;

const config = await getGlobalConfig();

// Default fallbacks if config is missing
const phone = config["phone"] || SITE_CONFIG.phone;
const phoneClean = normalizePhoneForTel(phone) || config["phone_clean"] || SITE_CONFIG.phoneClean;
const email = config["email"] || SITE_CONFIG.email;
const address = config["address"] || SITE_CONFIG.address;
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		{isDev && <meta name="robots" content="noindex, nofollow" />}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- Google Tag Manager -->
		<script is:inline define:vars={{ gtmId: import.meta.env.PUBLIC_GTM_ID }}
		>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({
					"gtm.start": new Date().getTime(),
					event: "gtm.js",
				});
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != "dataLayer" ? "&l=" + l : "";
				j.async = true;
				j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, "script", "dataLayer", gtmId);
		</script>
		<!-- End Google Tag Manager -->

		<SEOHead
			title={`${title} | МАСТЕР ВОЗДУХА`}
			description={description}
			image={image}
			type={type}
			price={price}
			currency={currency}
			canonical={canonical}
			robots={robots}
		/>

		<link
			href="https://fonts.googleapis.com/icon?family=Material+Icons+Round"
			rel="stylesheet"
		/>

		{
			articleDate && (
				<meta property="article:published_time" content={articleDate} />
			)
		}

		<script is:inline>
			const theme = (() => {
				if (
					typeof localStorage !== "undefined" &&
					localStorage.getItem("theme")
				) {
					return localStorage.getItem("theme");
				}
				if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
					return "dark";
				}
				return "light";
			})();

			if (theme === "light") {
				document.documentElement.classList.remove("dark");
			} else {
				document.documentElement.classList.add("dark");
			}
			window.localStorage.setItem("theme", theme);
		</script>
	</head>
	<body
		class="bg-bg text-text transition-colors duration-300 min-h-screen flex flex-col"
	>
		<!-- Google Tag Manager (noscript) -->
		<noscript
			><iframe
				src={`https://www.googletagmanager.com/ns.html?id=${import.meta.env.PUBLIC_GTM_ID}`}
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe></noscript
		>
		<!-- End Google Tag Manager (noscript) -->

		<nav class="sticky-nav">
			<div class="container nav-container">
				<a href="/" class="logo-group">
					<div class="logo-img-wrapper">
						<img
							src="/img/logos/logo.svg"
							alt="MB"
							class="logo-img light-only"
						/>
						<img
							src="/img/logos/logo-white.svg"
							alt="MB"
							class="logo-img dark-only"
						/>
					</div>
					<div class="logo-text">
						<span class="logo-title">МАСТЕР ВОЗДУХА</span>
						<span class="logo-subtitle"
							>кондиционеры в Витебске</span
						>
					</div>
				</a>

				<div class="nav-links">
					<div class="nav-dropdown">
						<button
							type="button"
							class="nav-dropdown-trigger"
							aria-expanded="false"
							aria-controls="catalog-menu"
						>
							<span>Каталог</span>
							<span class="material-icons-round">expand_more</span>
						</button>
						<div id="catalog-menu" class="nav-dropdown-menu">
							<a href="/catalog?tag_slugs=cat-household">Бытовые</a>
							<a href="/catalog?tag_slugs=cat-multi">Мультисплит</a>
							<a href="/catalog?tag_slugs=cat-industrial">Полупром</a>
						</div>
					</div>
					<a href="/services">Услуги</a>
					<a href="/blog">Статьи</a>
					<a href="/contacts">Контакты</a>
				</div>

				<div class="nav-actions">
					<MobileMenu phoneClean={phoneClean} client:media="(max-width: 980px)" />
					<button
						id="theme-toggle"
						class="icon-btn"
						aria-label="Toggle theme"
					>
						<span class="material-icons-round moon">dark_mode</span>
						<span class="material-icons-round sun">light_mode</span>
					</button>
					<HeaderCart client:load />
					<a
						href={`tel:${phoneClean}`}
						class="btn btn-primary call-btn js-track-phone"
					>
						<span class="material-icons-round">call</span>
						<span class="btn-text">Позвонить</span>
					</a>
				</div>
			</div>
		</nav>

		<main class="flex-grow">
			<slot />
			<ToastContainer client:idle />
		</main>

		<footer class="footer">
			<div class="container footer-grid">
				<div class="footer-brand">
					<div class="logo-group">
						<div class="logo-img-wrapper">
							<img
								src="/img/logos/logo.svg"
								alt="MB"
								class="logo-img light-only"
							/>
							<img
								src="/img/logos/logo-white.svg"
								alt="MB"
								class="logo-img dark-only"
							/>
						</div>
						<div class="logo-text">
							<span class="logo-title">МАСТЕР ВОЗДУХА</span>
							<span class="logo-subtitle">Системы комфорта</span>
						</div>
					</div>
					<p class="footer-desc">
						Профессиональные решения для вентиляции и
						кондиционирования. Создаем идеальный климат в вашем доме
						и офисе.
					</p>
				</div>

				<div class="footer-col">
					<h4>Контакты</h4>
					<ul class="footer-links">
						<li>
							<span class="material-icons-round mini"
								>location_on</span
							>
							{address}
						</li>
						<li>
							<span class="material-icons-round mini">phone</span>
							<a href={`tel:${phoneClean}`} class="js-track-phone"
								>{phone}</a
							>
						</li>
						<li>
							<span class="material-icons-round mini">email</span>
							<a href={`mailto:${email}`}>{email}</a>
						</li>
					</ul>
				</div>

				<div class="footer-col">
					<h4>Меню</h4>
					<ul class="footer-links">
						<li><a href="/catalog">Каталог</a></li>
						<li><a href="/services">Услуги</a></li>
						<li><a href="/contacts">О нас</a></li>
						<li><a href="/offer">Публичная оферта</a></li>
						<li><a href="/privacy">Конфиденциальность</a></li>
						<li><a href="/terms">Условия</a></li>
					</ul>
				</div>

				<div class="footer-col">
					<h4>Соцсети</h4>
					<div class="social-links">
						<a href="#" class="social-btn"
							><span class="material-icons-round">chat</span></a
						>
						<a href="#" class="social-btn"
							><span class="material-icons-round">send</span></a
						>
					</div>
				</div>
			</div>
			<div class="footer-bottom">
				<p>
					© 2026 МАСТЕР ВОЗДУХА. Все права защищены.
					<a href="/offer">Публичная оферта</a>
					<span aria-hidden="true"> · </span>
					<a href="/privacy">Политика конфиденциальности</a>
					<span aria-hidden="true"> · </span>
					<a href="/terms">Условия использования</a>
				</p>
			</div>
		</footer>

		<script>
			const themeToggle = document.getElementById("theme-toggle");
			themeToggle?.addEventListener("click", () => {
				const isDark =
					document.documentElement.classList.toggle("dark");
				localStorage.setItem("theme", isDark ? "dark" : "light");
			});

			const navDropdown = document.querySelector(".nav-dropdown");
			const navDropdownTrigger = document.querySelector(".nav-dropdown-trigger");
			if (navDropdown && navDropdownTrigger) {
				let closeTimer = null;
				let pinnedOpen = false;

				const setOpen = (isOpen) => {
					navDropdown.classList.toggle("open", isOpen);
					navDropdownTrigger.setAttribute(
						"aria-expanded",
						isOpen ? "true" : "false",
					);
				};

				const clearCloseTimer = () => {
					if (closeTimer) {
						clearTimeout(closeTimer);
						closeTimer = null;
					}
				};

				const openDropdown = () => {
					clearCloseTimer();
					setOpen(true);
				};

				const closeDropdown = () => {
					clearCloseTimer();
					setOpen(false);
				};

				const scheduleClose = () => {
					if (pinnedOpen) return;
					clearCloseTimer();
					closeTimer = setTimeout(() => {
						setOpen(false);
					}, 220);
				};

				navDropdown.addEventListener("mouseenter", () => {
					openDropdown();
				});

				navDropdown.addEventListener("mouseleave", () => {
					scheduleClose();
				});

				navDropdownTrigger.addEventListener("click", (event) => {
					event.preventDefault();
					const isAlreadyPinned = pinnedOpen && navDropdown.classList.contains("open");
					if (isAlreadyPinned) {
						pinnedOpen = false;
						closeDropdown();
						return;
					}

					pinnedOpen = true;
					openDropdown();
				});

				navDropdown.querySelectorAll(".nav-dropdown-menu a").forEach((link) => {
					link.addEventListener("click", () => {
						pinnedOpen = false;
						closeDropdown();
					});
				});

				document.addEventListener("click", (event) => {
					if (!navDropdown.contains(event.target)) {
						pinnedOpen = false;
						closeDropdown();
					}
				});

				document.addEventListener("keydown", (event) => {
					if (event.key === "Escape") {
						pinnedOpen = false;
						closeDropdown();
					}
				});
			}
		</script>
	</body>
</html>
