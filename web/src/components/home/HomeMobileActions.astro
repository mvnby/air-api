---
import { HOMEPAGE_ANALYTICS_EVENTS } from "../../config/homepage";

interface Props {
    phoneClean: string;
}

const { phoneClean } = Astro.props;
---

<nav class="home-mobile-actions" aria-label="Быстрые действия">
    <a
        href={`tel:${phoneClean}`}
        data-home-event={HOMEPAGE_ANALYTICS_EVENTS.mobileAction}
        data-home-action="call"
        data-home-item="phone"
        onclick="window.trackHomeConversion?.(this)"
    >
        <span class="material-icons-round" aria-hidden="true">call</span>
        <span>Позвонить</span>
    </a>
    <a
        href="/contacts/#contact-form"
        data-home-event={HOMEPAGE_ANALYTICS_EVENTS.mobileAction}
        data-home-action="write"
        data-home-item="contact_form"
        onclick="window.trackHomeConversion?.(this)"
    >
        <span class="material-icons-round" aria-hidden="true">chat</span>
        <span>Написать</span>
    </a>
    <a
        href="/catalog/"
        data-home-event={HOMEPAGE_ANALYTICS_EVENTS.mobileAction}
        data-home-action="select"
        data-home-item="catalog"
        onclick="window.trackHomeConversion?.(this)"
    >
        <span class="material-icons-round" aria-hidden="true">tune</span>
        <span>Подобрать</span>
    </a>
</nav>

<script>
    const actionBar = document.querySelector(".home-mobile-actions");
    const footer = document.querySelector("footer");

    if (actionBar && footer && "IntersectionObserver" in window) {
        const footerObserver = new IntersectionObserver(
            ([entry]) => actionBar.classList.toggle("is-hidden", entry.isIntersecting),
            { threshold: 0.05 },
        );
        footerObserver.observe(footer);
    }
</script>

<style>
    .home-mobile-actions {
        display: none;
    }

    @media (max-width: 767px) {
        :global(body) {
            padding-bottom: calc(78px + env(safe-area-inset-bottom));
        }

        .home-mobile-actions {
            position: fixed;
            z-index: 45;
            right: 0;
            bottom: 0;
            left: 0;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            min-height: 58px;
            padding: 0.35rem;
            border: 1px solid var(--panel-glass-border);
            border-radius: 8px 8px 0 0;
            background: var(--panel-glass-bg);
            box-shadow: var(--panel-glass-shadow);
            backdrop-filter: blur(14px);
            padding-bottom: max(0.35rem, env(safe-area-inset-bottom));
            transition: opacity 0.18s ease, transform 0.18s ease;
        }

        .home-mobile-actions.is-hidden {
            pointer-events: none;
            opacity: 0;
            transform: translateY(120%);
        }

        .home-mobile-actions a {
            display: grid;
            grid-template-rows: 24px auto;
            place-items: center;
            min-width: 0;
            min-height: 50px;
            border-radius: 6px;
            color: var(--text-muted);
            font-size: 0.7rem;
            font-weight: 800;
        }

        .home-mobile-actions a:last-child {
            background: var(--panel-active-gradient);
            color: var(--panel-active-text);
        }

        .home-mobile-actions a:focus-visible {
            outline: 3px solid var(--accent);
            outline-offset: 0;
        }

        .home-mobile-actions .material-icons-round {
            font-size: 21px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .home-mobile-actions {
            transition: none;
        }
    }
</style>
