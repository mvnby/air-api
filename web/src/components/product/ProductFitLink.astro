---
interface Props {
    href: string;
    productSlug: string;
    analyticsEvent?: string;
}

const { href, productSlug, analyticsEvent = "" } = Astro.props;
---

<a
    class="product-fit-link"
    href={href}
    data-home-event={analyticsEvent || undefined}
    data-home-action={analyticsEvent ? "check_fit" : undefined}
    data-home-item={analyticsEvent ? productSlug : undefined}
    onclick={analyticsEvent ? "window.trackHomeConversion?.(this)" : undefined}
>
    Проверить, подойдёт ли мне
    <span class="material-icons-round" aria-hidden="true">arrow_forward</span>
</a>

<style>
    .product-fit-link {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        width: 100%;
        min-height: 42px;
        margin-top: 0.75rem;
        padding-top: 0.7rem;
        border-top: 1px solid var(--border);
        color: var(--primary);
        font-size: 0.82rem;
        font-weight: 800;
    }

    .product-fit-link:hover {
        color: var(--primary-dark);
    }

    .product-fit-link:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
    }

    .product-fit-link .material-icons-round {
        font-size: 18px;
    }
</style>
