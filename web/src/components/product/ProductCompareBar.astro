<aside id="product-compare-bar" class="product-compare-bar" aria-live="polite" hidden>
    <div class="product-compare-bar__copy">
        <span class="material-icons-round" aria-hidden="true">compare_arrows</span>
        <span class="product-compare-bar__label">Выбрано:</span>
        <strong data-compare-count>0</strong>
        <span>из 3</span>
    </div>
    <a href="/compare/" data-compare-open>Сравнить модели</a>
    <button type="button" data-compare-clear aria-label="Очистить сравнение" title="Очистить сравнение">
        <span class="material-icons-round" aria-hidden="true">close</span>
    </button>
</aside>

<script>
    import {
        buildCompareUrl,
        MAX_COMPARE_PRODUCTS,
        normalizeCompareItems,
        PRODUCT_COMPARE_STORAGE_KEY,
        type ProductCompareItem,
    } from "../../utils/product-compare";

    const compareBar = document.getElementById("product-compare-bar");
    const compareCount = compareBar?.querySelector("[data-compare-count]");
    const compareOpen = compareBar?.querySelector<HTMLAnchorElement>("[data-compare-open]");
    const compareClear = compareBar?.querySelector<HTMLButtonElement>("[data-compare-clear]");
    const comparePageOpen = window.location.pathname.startsWith("/compare");

    const readItems = (): ProductCompareItem[] => {
        try {
            return normalizeCompareItems(
                JSON.parse(localStorage.getItem(PRODUCT_COMPARE_STORAGE_KEY) || "[]"),
            );
        } catch {
            return [];
        }
    };

    const writeItems = (items: ProductCompareItem[]) => {
        const normalized = normalizeCompareItems(items);
        localStorage.setItem(PRODUCT_COMPARE_STORAGE_KEY, JSON.stringify(normalized));
        window.dispatchEvent(new CustomEvent("mvn:compare-change"));
    };

    const trackCompare = (event: string, action: string, item = "") => {
        const analyticsWindow = window as Window & {
            dataLayer?: Array<Record<string, string>>;
        };
        analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
        analyticsWindow.dataLayer.push({ event, action, item });
    };

    const renderCompare = () => {
        const items = readItems();
        const selected = new Set(items.map((item) => item.slug));
        const limitReached = items.length >= MAX_COMPARE_PRODUCTS;

        document.querySelectorAll<HTMLButtonElement>("[data-compare-product]").forEach((button) => {
            const slug = button.dataset.compareSlug || "";
            const active = selected.has(slug);
            const label = button.querySelector("[data-compare-label]");
            button.setAttribute("aria-pressed", String(active));
            button.disabled = limitReached && !active;
            button.title = button.disabled ? "Можно сравнить не больше трёх моделей" : "";
            const nextLabel = active ? "В сравнении" : "Сравнить";
            if (label && label.textContent !== nextLabel) label.textContent = nextLabel;
        });

        if (!compareBar || !compareCount || !compareOpen) return;
        compareBar.hidden = comparePageOpen || items.length === 0;
        compareCount.textContent = String(items.length);
        compareOpen.href = buildCompareUrl(items);
        compareOpen.textContent = items.length < 2 ? "Выберите ещё" : "Сравнить модели";
        compareOpen.setAttribute("aria-disabled", String(items.length < 2));
    };

    document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest<HTMLButtonElement>("[data-compare-product]");
        if (!button) return;

        const slug = button.dataset.compareSlug || "";
        const title = button.dataset.compareTitle || slug;
        if (!slug) return;
        let snapshot: Record<string, unknown> | undefined;
        try {
            const parsed = JSON.parse(button.dataset.comparePayload || "null");
            if (parsed && typeof parsed === "object") snapshot = parsed;
        } catch {
            snapshot = undefined;
        }

        const items = readItems();
        const exists = items.some((item) => item.slug === slug);
        const nextItems = exists
            ? items.filter((item) => item.slug !== slug)
            : [...items, { slug, title, snapshot }];
        writeItems(nextItems);
        trackCompare("product_compare_toggle", exists ? "remove" : "add", slug);
    });

    compareClear?.addEventListener("click", () => {
        writeItems([]);
        trackCompare("product_compare_toggle", "clear");
    });

    compareOpen?.addEventListener("click", (event) => {
        if (readItems().length < 2) {
            event.preventDefault();
            return;
        }
        trackCompare("product_compare_open", "open", String(readItems().length));
    });

    window.addEventListener("mvn:compare-change", renderCompare);
    window.addEventListener("storage", (event) => {
        if (event.key === PRODUCT_COMPARE_STORAGE_KEY) renderCompare();
    });

    let renderScheduled = false;
    const observer = new MutationObserver(() => {
        if (renderScheduled) return;
        renderScheduled = true;
        requestAnimationFrame(() => {
            renderScheduled = false;
            renderCompare();
        });
    });
    const main = document.querySelector("main");
    if (main) observer.observe(main, { childList: true, subtree: true });
    renderCompare();
</script>

<style>
    .product-compare-bar {
        position: fixed;
        z-index: 44;
        right: 1rem;
        bottom: calc(1rem + env(safe-area-inset-bottom));
        display: flex;
        align-items: center;
        gap: 0.75rem;
        max-width: min(460px, calc(100vw - 2rem));
        min-height: 56px;
        padding: 0.55rem;
        border: 1px solid var(--panel-glass-border);
        border-radius: 8px;
        background: var(--panel-glass-bg);
        box-shadow: var(--panel-glass-shadow);
        backdrop-filter: blur(16px);
    }

    .product-compare-bar[hidden] { display: none; }

    .product-compare-bar__copy {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        min-width: 0;
        color: var(--text);
        font-size: 0.82rem;
    }

    .product-compare-bar__copy .material-icons-round { color: var(--primary); }

    .product-compare-bar > a {
        min-height: 40px;
        padding: 0.65rem 0.8rem;
        border-radius: 8px;
        background: var(--primary);
        color: var(--panel-active-text);
        font-size: 0.82rem;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
    }

    .product-compare-bar > a[aria-disabled="true"] {
        opacity: 0.55;
        pointer-events: none;
    }

    .product-compare-bar > button {
        display: grid;
        flex: 0 0 40px;
        width: 40px;
        height: 40px;
        place-items: center;
        border: 0;
        background: transparent;
        color: var(--text-muted);
        cursor: pointer;
    }

    .product-compare-bar a:focus-visible,
    .product-compare-bar button:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 2px;
    }

    @media (max-width: 767px) {
        .product-compare-bar {
            right: 0.5rem;
            bottom: calc(0.5rem + env(safe-area-inset-bottom));
            left: 0.5rem;
            max-width: none;
        }

        :global(body:has(.home-mobile-actions)) .product-compare-bar {
            bottom: calc(68px + env(safe-area-inset-bottom));
        }

        .product-compare-bar__copy { flex: 1; }
        .product-compare-bar__label { display: none; }
    }
</style>
