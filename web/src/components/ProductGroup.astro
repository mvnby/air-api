---
import ProductCard from "./ProductCard.astro";
import { getCatalog, getVitebskFeaturedProducts } from "../utils/api";

interface Props {
    title?: string;
    tags?: string[];
    vitebskFeatured?: boolean;
    filters?: {
        area_min?: number;
        area_max?: number;
        is_inverter?: boolean;
        has_wifi?: boolean;
        has_fresh_air?: boolean;
        heating_min?: number;
        indoor_types?: string[];
    };
    limit?: number;
}

const { title, tags = [], vitebskFeatured = false, filters = {}, limit = 4 } = Astro.props;

let products: any[] = [];

const viewAllHref = (() => {
    if (vitebskFeatured) return "/catalog";

    const viewAllParams = new URLSearchParams();
    if (tags.length) viewAllParams.set("tag_slugs", tags.join(","));
    if (filters.area_min != null) viewAllParams.set("area_min", String(filters.area_min));
    if (filters.area_max != null) viewAllParams.set("area_max", String(filters.area_max));
    if (filters.is_inverter != null) viewAllParams.set("is_inverter", String(filters.is_inverter));
    if (filters.has_wifi != null) viewAllParams.set("has_wifi", String(filters.has_wifi));
    if (filters.has_fresh_air != null) viewAllParams.set("has_fresh_air", String(filters.has_fresh_air));
    if (filters.heating_min != null) viewAllParams.set("heating_min", String(filters.heating_min));
    if (filters.indoor_types?.length) {
        filters.indoor_types.forEach((value) => viewAllParams.append("indoor_types", value));
    }

    const query = viewAllParams.toString();
    return query ? `/catalog?${query}` : "/catalog";
})();

// Fetch products:
// - regular group: via /v1/catalog with faceted filters
// - vitebsk featured: via /v1/products/vitebsk-featured (real stock only)
if (vitebskFeatured) {
    products = await getVitebskFeaturedProducts();
    products = products.slice(0, limit);
} else {
    const data = await getCatalog({
        tag_slugs: tags,
        area_min: filters.area_min,
        area_max: filters.area_max,
        is_inverter: filters.is_inverter,
        has_wifi: filters.has_wifi,
        has_fresh_air: filters.has_fresh_air,
        heating_min: filters.heating_min,
        indoor_types: filters.indoor_types,
        limit: limit,
        sort: "area_asc",
    });
    products = data.items || [];
}
---

{
    products.length > 0 && (
        <section class="product-group-section">
            {title && (
                <div class="group-header">
                    <h3>{title}</h3>
                    <a
                        href={viewAllHref}
                        class="view-all"
                    >
                        Смотреть все{" "}
                        <span class="material-icons-round">arrow_forward</span>
                    </a>
                </div>
            )}

            <div class="group-grid">
                {products.map((product: any) => (
                    <ProductCard
                        product={product}
                        variant="default"
                        showInstallation={true}
                    />
                ))}
            </div>
        </section>
    )
}

<style>
    .product-group-section {
        margin-bottom: 4rem;
    }

    .group-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

    .group-header h3 {
        font-size: 1.75rem;
        font-weight: 800;
    }

    .view-all {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        color: #0f766e;
        text-decoration: none;
        transition:
            gap 0.2s ease,
            color 0.2s ease;
    }

    .view-all:hover {
        gap: 0.75rem;
        color: var(--primary-dark);
    }

    :global(.dark) .view-all {
        color: #99f6e4;
    }

    :global(.dark) .view-all:hover {
        color: #ccfbf1;
    }

    .group-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    @media (max-width: 1360px) {
        .product-group-section {
            margin-bottom: 3.5rem;
        }

        .group-header {
            margin-bottom: 1.5rem;
            gap: 1rem;
        }

        .group-header h3 {
            font-size: 1.6rem;
        }

        .group-grid {
            gap: 1.5rem;
        }
    }

    @media (max-width: 1200px) {
        .group-header {
            align-items: flex-start;
            flex-wrap: wrap;
        }
    }

    @media (max-width: 1100px) {
        .group-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 768px) {
        .group-header {
            margin-bottom: 1.25rem;
        }

        .group-header h3 {
            font-size: 1.5rem;
        }

        .group-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
