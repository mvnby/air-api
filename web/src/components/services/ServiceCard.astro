---
import type { ServiceDefinition } from "../../config/services";

interface Props {
    service: ServiceDefinition;
}

const { service } = Astro.props;
---

<a
    class="service-card"
    href={service.href}
    aria-label={`${service.title}: подробнее об услуге`}
>
    <div class="service-visual" aria-hidden="true">
        <img
            src={service.image}
            alt=""
            width="1672"
            height="941"
            loading="lazy"
            decoding="async"
        />
    </div>

    <div class="service-content">
        <div class="service-cue">
            <span class="cue-icon material-icons-round" aria-hidden="true">
                {service.icon}
            </span>
            <span>{service.cue}</span>
        </div>

        <h3>{service.title}</h3>
        <p>{service.description}</p>

        <span class="service-link" aria-hidden="true">
            Подробнее
            <span class="material-icons-round">arrow_forward</span>
        </span>
    </div>
</a>

<style>
    .service-card {
        min-width: 0;
        height: 100%;
        display: grid;
        grid-template-rows: auto 1fr;
        overflow: hidden;
        border: 1px solid var(--panel-glass-border);
        border-radius: 22px;
        background: var(--panel-glass-bg);
        box-shadow: var(--panel-glass-shadow);
        color: var(--text);
        transition:
            transform 180ms ease,
            border-color 180ms ease,
            box-shadow 180ms ease;
    }

    .service-card:hover {
        transform: translateY(-4px);
        border-color: var(--panel-chip-hover-border);
        box-shadow: var(--shadow-lg);
    }

    .service-card:focus-visible {
        outline: 3px solid var(--primary);
        outline-offset: 4px;
    }

    .service-visual {
        min-width: 0;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: var(--panel-chip-bg);
        border-bottom: 1px solid var(--panel-chip-border);
    }

    .service-visual img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 260ms ease;
    }

    .service-card:hover .service-visual img {
        transform: scale(1.015);
    }

    .service-content {
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.8rem;
        padding: 1.35rem;
    }

    .service-cue {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-muted);
        font-size: 0.78rem;
        font-weight: 750;
        letter-spacing: 0.01em;
    }

    .cue-icon {
        width: 2rem;
        height: 2rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        border: 1px solid var(--panel-chip-border);
        border-radius: 10px;
        background: var(--panel-chip-bg);
        color: var(--primary);
        font-size: 1.05rem;
    }

    h3 {
        margin: 0;
        font-size: clamp(1.2rem, 2vw, 1.5rem);
        line-height: 1.16;
        text-wrap: balance;
    }

    p {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.96rem;
        line-height: 1.62;
    }

    .service-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: auto;
        padding-top: 0.35rem;
        color: var(--primary);
        font-weight: 750;
    }

    .service-link .material-icons-round {
        font-size: 1.1rem;
        transition: transform 180ms ease;
    }

    .service-card:hover .service-link .material-icons-round {
        transform: translateX(4px);
    }

    @media (max-width: 680px) {
        .service-card {
            border-radius: 18px;
        }

        .service-visual {
            aspect-ratio: 16 / 9;
        }

        .service-content {
            gap: 0.62rem;
            padding: 1rem;
        }

        .service-cue {
            align-items: flex-start;
            font-size: 0.72rem;
            line-height: 1.35;
        }

        .cue-icon {
            display: none;
        }

        h3 {
            font-size: 1.12rem;
        }

        p {
            font-size: 0.87rem;
            line-height: 1.5;
        }

        .service-link {
            font-size: 0.88rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .service-card,
        .service-visual img,
        .service-link .material-icons-round {
            transition: none;
        }
    }
</style>
