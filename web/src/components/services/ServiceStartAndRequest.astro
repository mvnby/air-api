---
import ContactForm from "../ContactForm.vue";

const startSteps = [
    {
        title: "Подготовьте исходные данные",
        description:
            "Фото, видео или план помогут быстрее разобраться. После заявки подскажем, куда их отправить. Для неисправности пригодится модель блока.",
    },
    {
        title: "Уточним условия",
        description:
            "Спросим про помещение, доступ к блокам, готовую трассу, режим работы и удобное время.",
    },
    {
        title: "Предложим решение",
        description:
            "Дадим предварительный расчёт или назначим осмотр, если без замеров нельзя корректно оценить работу.",
    },
];
---

<section class="container start-section">
    <div class="start-copy">
        <p class="section-kicker">Первый шаг</p>
        <h2>Не обязательно заранее знать, какая услуга нужна</h2>
        <p>
            Расскажите, что нужно сделать. Мы отделим то, что можно оценить
            дистанционно, от того, для чего действительно нужен осмотр.
        </p>
        <a class="inline-link" href="#service-request">
            Описать задачу
            <span class="material-icons-round" aria-hidden="true">south</span>
        </a>
    </div>

    <ol class="start-steps">
        {
            startSteps.map((step, index) => (
                <li>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <div>
                        <h3>{step.title}</h3>
                        <p>{step.description}</p>
                    </div>
                </li>
            ))
        }
    </ol>
</section>

<section class="container request-section" id="service-request">
    <div class="request-copy">
        <p class="section-kicker">Обсудить задачу</p>
        <h2>Опишите задачу — уточним детали и перезвоним</h2>
        <p>
            Укажите тип помещения и кратко опишите, что нужно сделать. Фото и
            план можно будет отправить после первого контакта.
        </p>
    </div>

    <div class="request-form">
        <ContactForm
            client:visible
            title="Описать задачу"
            subtitle="Свяжемся, уточним условия и предложим следующий шаг"
            buttonText="Отправить заявку"
            subject="Заявка со страницы услуг"
            commentLabel="Что нужно сделать (необязательно)"
            commentPlaceholder="Например: идёт ремонт, хочу заранее проложить трассу..."
        />
    </div>
</section>

<style>
    .section-kicker {
        margin: 0 0 0.75rem;
        color: var(--primary);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.11em;
        text-transform: uppercase;
    }

    .start-section {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: clamp(2rem, 6vw, 5rem);
        align-items: start;
        margin-bottom: clamp(5rem, 9vw, 8rem);
        padding-top: clamp(2rem, 5vw, 4rem);
        padding-bottom: clamp(2rem, 5vw, 4rem);
        border-top: 1px solid var(--panel-chip-border);
        border-bottom: 1px solid var(--panel-chip-border);
    }

    .start-copy h2,
    .request-copy h2 {
        margin: 0;
        font-size: clamp(2rem, 4.5vw, 3.4rem);
        letter-spacing: -0.035em;
        line-height: 1.06;
        text-wrap: balance;
    }

    .start-copy > p:not(.section-kicker),
    .request-copy > p:not(.section-kicker) {
        max-width: 680px;
        margin: 1rem 0 0;
        color: var(--text-muted);
        font-size: 1.02rem;
        line-height: 1.65;
    }

    .inline-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 1.25rem;
        color: var(--primary);
        font-weight: 750;
    }

    .inline-link:focus-visible {
        outline: 3px solid var(--primary);
        outline-offset: 4px;
        border-radius: 8px;
    }

    .inline-link .material-icons-round {
        font-size: 1.1rem;
    }

    .start-steps {
        display: grid;
        gap: 0;
        margin: 0;
        padding: 0;
    }

    .start-steps li {
        display: grid;
        grid-template-columns: 46px minmax(0, 1fr);
        gap: 1rem;
        padding: 1.25rem 0;
        border-bottom: 1px solid var(--panel-chip-border);
    }

    .start-steps li:first-child {
        padding-top: 0;
    }

    .start-steps li > span {
        color: var(--primary);
        font-size: 0.8rem;
        font-weight: 850;
        letter-spacing: 0.08em;
    }

    .start-steps h3 {
        margin: 0 0 0.35rem;
        font-size: 1.05rem;
    }

    .start-steps p {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .request-section {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(360px, 0.72fr);
        gap: clamp(2.5rem, 7vw, 6rem);
        align-items: center;
        margin-bottom: clamp(5rem, 9vw, 8rem);
        scroll-margin-top: 110px;
    }

    .request-form {
        min-width: 0;
    }

    @media (max-width: 960px) {
        .start-section,
        .request-section {
            grid-template-columns: 1fr;
        }

        .request-form {
            max-width: 720px;
        }
    }

    @media (max-width: 680px) {
        .start-section,
        .request-section {
            min-width: 0;
            margin-bottom: 4.5rem;
        }
    }
</style>
