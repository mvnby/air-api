{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "test:brands": "node tests/brand-markdown.test.mjs && node tests/brand-series.test.mjs",
    "test:homepage": "node tests/homepage-config.test.mjs",
    "check-api": "node scripts/check-api.js",
    "audit:theme": "bash ../scripts/audit_theme_hardcodes.sh",
    "test:seo": "node scripts/test-seo-helpers.mjs",
    "build": "npm run check-api && astro build",
    "build:ssr:staging": "npm run check-api && astro build --config astro.config.ssr.mjs",
    "build:ssr:shadow": "SSR_BASE_PATH=/ npm run build:ssr:staging",
    "start:ssr:staging": "node ./dist/server/entry.mjs",
    "start:ssr:shadow": "npm run start:ssr:staging",
    "smoke:ssr:staging": "node scripts/smoke-ssr-staging.mjs",
    "smoke:ssr:shadow": "SSR_SMOKE_BASE_URL=http://127.0.0.1:4322 node scripts/smoke-ssr-staging.mjs",
    "image:content": "node scripts/content-images.mjs",
    "image:audit": "node scripts/content-images.mjs audit",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/node": "^9.5.2",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vue": "^5.1.4",
    "@nanostores/persistent": "^1.2.0",
    "@nanostores/vue": "^1.0.1",
    "astro": "^5.16.11",
    "imask": "^7.6.1",
    "nanostores": "^1.1.0",
    "tailwindcss": "^3.4.19",
    "vue": "^3.5.27"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.23",
    "node-fetch": "^3.3.2",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  }
}
