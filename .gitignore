# Секретные ключи (никогда не выгружать!)
.env
.env.local
.env.*.local

# Виртуальное окружение
.venv/
venv/

# База данных (чтобы не затереть серверную базу локальной)
*.db
*.sqlite3

# Кэш питона
__pycache__/
*.py[cod]

# Системные файлы
.DS_Store
.vscode/server.log

# Логи и временные файлы
*.log
*.log.*
app.log
server.log
bot.log

# Загрузки (Images/Files)
static/uploads/*
!static/uploads/.gitkeep
dump_repo.py
AI_AGENT_CONTEXT.md
credentials.json
client_secret.json
token.json
google-oauth/
g-vision-ocr.json
backups/*
/media/*
/model-cache/*
web/temp/*
var/seo/*
!var/seo/.gitkeep
.agent/workflows/plan.md
.agent/*
