# ====================================
# МАСТЕР ВОЗДУХА Environment Variables
# ====================================
# Copy this file to .env and fill in the values

# CORS Origins (comma-separated for multiple)
CORS_ORIGINS=["https://mvn.by","https://dev.mvn.by","http://localhost:4321"]
# Local-safe default for manager_frontend.
# For local overrides, create .env.development.local from .env.development.local.example.
# Production manager build gets WEBSITE_URL from GitHub Actions deploy workflow.
WEBSITE_URL=http://localhost:4321

# Google OAuth callback. Set this on production and add the same URI to
# Google Cloud Console -> OAuth client -> Authorized redirect URIs.
# Example: GOOGLE_OAUTH_REDIRECT_URI=https://api.mvn.by/api/manager/google-auth/callback
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/manager/google-auth/callback

# HTTP Basic Auth credentials
 ---
# --- Bot Settings ---
BOT_TOKEN=
ADMIN_ID=
ADMIN_IDS=

# --- Web Admin Auth ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
SECRET_KEY=

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=air_conditioners
# --- Backups ---
BACKUP_FOLDER_ID=gdisk_folder_id
# --- Mail (Yandex app password, not the main account password) ---
MAIL_IMAP_HOST=imap.yandex.ru
MAIL_IMAP_PORT=993
MAIL_IMAP_USE_SSL=true
MAIL_IMAP_USERNAME=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_BANK_FOLDER=INBOX
MAIL_IMAP_PROCESSED_FOLDER=
MAIL_IMAP_AUTO_IMPORT_ENABLED=true
MAIL_IMAP_IMPORT_INTERVAL_MINUTES=20
MAIL_SMTP_HOST=smtp.yandex.ru
MAIL_SMTP_PORT=465
MAIL_SMTP_USE_SSL=true
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Мастер Воздуха
# --- Optional ---
LOG_LEVEL=INFO
