# ====================================
# МАСТЕР ВОЗДУХА Environment Variables
# ====================================
# Copy this file to .env and fill in the values

# CORS Origins (comma-separated for multiple)
CORS_ORIGINS=["https://mvn.by","https://dev.mvn.by","http://localhost:4321"]
# Local-safe default for manager_frontend.
# For local overrides, create .env.development.local from .env.development.local.example.
# Production manager build gets WEBSITE_URL from GitHub Actions deploy workflow.
WEBSITE_URL=http://localhost:4321
# Public storefront base URL used by backend catalog freshness purges.
PUBLIC_SITE_URL=https://mvn.by

# --- Cloudflare catalog cache purge ---
# Safe defaults: disabled + dry-run, even if credentials are present.
CLOUDFLARE_PURGE_ENABLED=false
CLOUDFLARE_PURGE_DRY_RUN=true
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Google OAuth callback. Set this on production and add the same URI to
# Google Cloud Console -> OAuth client -> Authorized redirect URIs.
# Example: GOOGLE_OAUTH_REDIRECT_URI=https://api.mvn.by/api/manager/google-auth/callback
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/manager/google-auth/callback

# Google Vision OCR service account for requisites recognition.
GOOGLE_VISION_CREDENTIALS_FILE=/app/g-vision-ocr.json
GOOGLE_VISION_PROJECT_ID=

# HTTP Basic Auth credentials
 ---
# --- Bot Settings ---
BOT_TOKEN=
ADMIN_ID=
ADMIN_IDS=

# --- Web Admin Auth ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
SECRET_KEY=

# --- Runtime role / single-active controls ---
# Current primary/default behavior: APP_ROLE=primary, scheduler follows APP_ROLE,
# bot polling follows APP_ROLE.
# Standby API: set APP_ROLE=standby, SCHEDULER_ENABLED=false, BOT_ENABLED=false,
# and do not start the bot service.
APP_ROLE=primary
# SCHEDULER_ENABLED=true
# BOT_ENABLED=true

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=air_conditioners
# --- Backups ---
BACKUP_FOLDER_ID=gdisk_folder_id
# --- Product media storage (local by default; R2/S3 secrets are optional until enabled) ---
PRODUCT_MEDIA_STORAGE_PROVIDER=local
PRODUCT_MEDIA_LOCAL_VARIANT_DIR=media/products/variants
PRODUCT_MEDIA_LOCAL_VARIANT_PUBLIC_PREFIX=/media/products/variants
PRODUCT_MEDIA_ORIGINAL_SOURCE_PROVIDER=local
PRODUCT_MEDIA_LOCAL_ORIGINAL_DIR=media/products/shared
PRODUCT_MEDIA_LOCAL_ORIGINAL_PUBLIC_PREFIX=/media/products/shared
PRODUCT_MEDIA_S3_BUCKET=
PRODUCT_MEDIA_S3_ENDPOINT_URL=
PRODUCT_MEDIA_S3_REGION=auto
PRODUCT_MEDIA_S3_ACCESS_KEY_ID=
PRODUCT_MEDIA_S3_SECRET_ACCESS_KEY=
PRODUCT_MEDIA_S3_PUBLIC_BASE_URL=
PRODUCT_MEDIA_S3_KEY_PREFIX=products/variants
PRODUCT_MEDIA_S3_CACHE_CONTROL=public, max-age=31536000, immutable
# --- Mail (Yandex app password, not the main account password) ---
MAIL_IMAP_HOST=imap.yandex.ru
MAIL_IMAP_PORT=993
MAIL_IMAP_USE_SSL=true
MAIL_IMAP_USERNAME=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_BANK_FOLDER=INBOX
MAIL_IMAP_PROCESSED_FOLDER=
MAIL_IMAP_AUTO_IMPORT_ENABLED=true
MAIL_IMAP_IMPORT_INTERVAL_MINUTES=20
MAIL_SMTP_HOST=smtp.yandex.ru
MAIL_SMTP_PORT=465
MAIL_SMTP_USE_SSL=true
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Мастер Воздуха
# --- Optional ---
LOG_LEVEL=INFO
