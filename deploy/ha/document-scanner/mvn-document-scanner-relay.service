[Unit]
Description=MVN private document scanner relay
Wants=network-online.target wg-quick@wg-mvn.service
After=network-online.target wg-quick@wg-mvn.service

[Service]
Type=simple
User=mvn-docscan
Group=mvn-docscan
UMask=0117
ExecStart=/usr/bin/stunnel4 /etc/mvn-document-scanner/stunnel.conf
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=10.77.0.1/32 10.77.0.2/32
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
RuntimeDirectory=mvn-document-scanner
RuntimeDirectoryMode=0750
MemoryMax=96M
TasksMax=32

[Install]
WantedBy=multi-user.target
