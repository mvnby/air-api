[Unit]
Description=MVN PostgreSQL PITR WAL upload
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/mvn-postgres-pitr.env
SuccessExitStatus=75
TimeoutStartSec=15min
TimeoutStopSec=30s
KillMode=control-group
ExecStart=/usr/bin/env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin HOME=/root LANG=C LC_ALL=C /usr/bin/python3 -I /usr/local/sbin/mvn-postgres-pitr-scheduled-runner --phase wal-upload --project-dir ${PROJECT_DIR} --compose-file ${COMPOSE_FILE}
